---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Ercan Kurtoğlu | GoHighLevel & AI Subscriptions',
  description = 'GoHighLevel iş sistemleri kurulumu, satış hunileri ve yapay zekâ abonelikleri. Pause or cancel anytime.',
  ogImage = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ercankurtoglu.site');
---

<!doctype html>
<html lang="tr" class="h-full bg-[#f7f7f7] dark:bg-[#0a0a0a] text-neutral-900 dark:text-neutral-100 antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Prevent Dark Mode & Language Flash Before Render (Geo & OS Auto-Detection) -->
    <script is:inline>
      (function() {
        // 1. Theme Detection: Respect manual choice, else read OS preference, fallback to light mode
        try {
          const savedTheme = localStorage.getItem('site_theme');
          const hasMatchMedia = window.matchMedia && typeof window.matchMedia === 'function';
          const systemPrefersDark = hasMatchMedia ? window.matchMedia('(prefers-color-scheme: dark)').matches : false;

          if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          document.documentElement.classList.remove('dark');
        }

        // 2. Language Detection: Turkey -> TR, Everywhere else in the world -> EN
        try {
          const savedLang = localStorage.getItem('site_lang');
          let initialLang = 'tr';

          if (savedLang === 'tr' || savedLang === 'en') {
            initialLang = savedLang;
          } else {
            // Check browser languages
            const navLangs = navigator.languages || [navigator.language || ''];
            const isTrLang = navLangs.some(function(l) { return l && l.toLowerCase().startsWith('tr'); });

            // Check system timezone
            let isTrTz = false;
            try {
              const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
              if (tz.indexOf('Istanbul') !== -1 || tz === 'Turkey') {
                isTrTz = true;
              }
            } catch(err) {}

            // Turkey visitors get TR, international visitors automatically get EN
            initialLang = (isTrLang || isTrTz) ? 'tr' : 'en';
          }

          document.documentElement.setAttribute('lang', initialLang);
        } catch (e) {
          document.documentElement.setAttribute('lang', 'tr');
        }
      })();
    </script>

    <!-- Google Fonts: Figtree + Newsreader (The exact Designjoy pairing) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500;1,6..72,600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-full bg-[#f7f7f7] dark:bg-[#0a0a0a] text-neutral-900 dark:text-neutral-100 font-sans antialiased transition-colors duration-200">
    <!-- Designjoy Frame: Centered with left and right vertical borders -->
    <div class="grid-frame max-w-[1240px] mx-auto min-h-screen shadow-sm flex flex-col relative">
      <Header />
      <main class="flex-grow">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Client-side site controls (Language & Dark Mode sync) -->
    <script src="../scripts/site-controller.ts"></script>
  </body>
</html>

<style is:global>
  body {
    font-family: 'Figtree', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
</style>
