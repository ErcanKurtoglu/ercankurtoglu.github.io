---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const research = await getCollection('research');
const renderedResearch = await Promise.all(
  research.map(async (item) => {
    const { Content } = await render(item);
    return { item, Content };
  })
);

const researchAreas = [
  {
    title: 'Nöro-Sembolik Yapay Zekâ (Neuro-symbolic AI)',
    description: 'Büyük dil modellerinin istatistiksel örüntü tanıma gücü ile formel mantık ve kural tabanlı sistemlerin kesinliğini birleştiren hibrit yapılar.',
  },
  {
    title: 'Çok Adımlı Muhakeme (Multi-Step Reasoning & Verification)',
    description: 'LLM çıktılarının halüsinasyon riskini en aza indiren otomatik doğrulama (self-correction, tree-of-thought) algoritmaları.',
  },
  {
    title: 'Otonom Çoklu Ajan Sistemleri (Multi-Agent Swarms)',
    description: 'Belirli kurallar çerçevesinde görev paylaşımı yapan, müzakere eden ve ortak hedefe ulaşan ajan ağlarının dinamikleri.',
  },
  {
    title: 'İş Süreçlerinde AI Entegrasyonu & Karar Destek',
    description: 'Karmaşık iş akışlarında insan gözetimli (human-in-the-loop) yapay zekâ karar mekanizmalarının modellenmesi.',
  },
];
---

<Layout
  title="Akademik & AI Araştırmaları | Ercan"
  description="Yapay zekâ muhakeme mekanizmaları, nöro-sembolik mimariler ve akademik araştırma alanları."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <header class="border-b border-zinc-200 pb-10 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200/80 text-amber-800 text-xs font-mono font-medium mb-4">
        AKADEMİK & ARAŞTIRMA
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-950">
        Araştırma Alanları & Yayınlar
      </h1>
      <p class="mt-4 text-base sm:text-lg text-zinc-600 max-w-2xl font-editorial">
        Yapay zekânın teorik sınırlarını inceleyen, mantıksal çıkarım ve otonom sistemler üzerine odaklanan çalışmalar.
      </p>
    </header>

    <!-- Research Areas Grid -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-zinc-950 mb-6 font-mono text-xs uppercase tracking-wider text-amber-700">
        // Odaklanılan Araştırma Alanları
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {researchAreas.map((area) => (
          <div class="p-6 rounded-xl border border-zinc-200 bg-white hover:border-zinc-300 transition-colors">
            <h3 class="text-base font-bold text-zinc-950 mb-2">
              {area.title}
            </h3>
            <p class="text-xs text-zinc-600 leading-relaxed font-editorial">
              {area.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Publications & Working Papers -->
    <section>
      <h2 class="text-xl font-bold text-zinc-950 mb-6 font-mono text-xs uppercase tracking-wider text-amber-700">
        // Yayınlar ve Çalışma Notları (Working Papers)
      </h2>

      <div class="space-y-8">
        {renderedResearch.map(({ item, Content }) => (
          <article class="rounded-xl border border-zinc-200 bg-white p-7 hover:border-zinc-300 transition-all">
            <div class="flex items-center justify-between text-xs font-mono text-zinc-500 mb-3">
              <span class="px-2.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 font-medium">
                {item.data.status}
              </span>
              <span>{item.data.year}</span>
            </div>

            <h3 class="text-xl font-bold text-zinc-950 tracking-tight mb-3">
              {item.data.title}
            </h3>

            <p class="text-sm text-zinc-600 leading-relaxed font-editorial mb-6">
              {item.data.abstract}
            </p>

            <div class="prose prose-zinc max-w-none text-xs text-zinc-700 leading-relaxed mb-6 pt-4 border-t border-zinc-100">
              <Content />
            </div>

            <!-- Tags & BibTeX -->
            <div class="space-y-4 pt-4 border-t border-zinc-100">
              <div class="flex flex-wrap gap-1.5">
                {item.data.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-100 text-zinc-600">
                    {tag}
                  </span>
                ))}
              </div>

              {item.data.bibtex && (
                <details class="text-xs group">
                  <summary class="cursor-pointer font-mono text-zinc-600 hover:text-zinc-950 select-none flex items-center gap-1.5">
                    <span>BibTeX Alıntısını Göster</span>
                    <span class="group-open:rotate-90 transition-transform">▸</span>
                  </summary>
                  <pre class="mt-2 p-3 rounded-lg bg-zinc-900 text-zinc-200 font-mono text-[11px] overflow-x-auto">
                    <code>{item.data.bibtex}</code>
                  </pre>
                </details>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
