---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

// Render markdown descriptions for each service
const renderedServices = await Promise.all(
  sortedServices.map(async (service) => {
    const { Content } = await render(service);
    return { service, Content };
  })
);
---

<Layout
  title="İş & GHL Çözümleri | GoHighLevel Otomasyonları ve Sistem Kurulumu"
  description="İşletmeniz için anahtar teslim GoHighLevel (GHL) otomasyonları, CRM mimarisi, yapay zekâ entegrasyonları ve süreç optimizasyonu."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <!-- Header -->
    <header class="max-w-3xl border-b border-zinc-200 pb-10 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200/80 text-amber-800 text-xs font-mono font-medium mb-4">
        BUSINESS & OTOMASYON DANIŞMANLIĞI
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-950 leading-tight">
        İşletmenizi Otomatize Edin, Satış Operasyonlarınızı Büyütün
      </h1>
      <p class="mt-4 text-lg text-zinc-600 leading-relaxed font-normal">
        GoHighLevel (GHL) başta olmak üzere modern bulut ve AI altyapılarını kullanarak, potansiyel müşteri yakalamadan faturalandırmaya kadar tüm iş süreçlerinizi tek merkezden yönetilebilir hale getiriyorum.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/contact"
          class="px-6 py-3 rounded-lg bg-zinc-950 text-white font-medium text-sm hover:bg-zinc-800 transition-colors shadow-sm"
        >
          Proje / Kurulum Teklifi Alın
        </a>
      </div>
    </header>

    <!-- Services Detailed List -->
    <div class="space-y-16">
      {renderedServices.map(({ service, Content }) => (
        <section id={service.id} class="rounded-2xl border border-zinc-200/90 bg-white p-8 sm:p-12 hover:border-zinc-300 transition-all shadow-sm">
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8">
            <div class="lg:w-2/3">
              <div class="flex items-center gap-3 mb-3">
                <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-amber-50 text-amber-900 border border-amber-200">
                  {service.data.category}
                </span>
                <span class="text-xs text-zinc-400 font-mono">Çözüm #{service.data.order}</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-bold text-zinc-950 tracking-tight mb-4">
                {service.data.title}
              </h2>

              <p class="text-base text-zinc-600 leading-relaxed mb-8 font-editorial">
                {service.data.tagline}
              </p>

              <!-- Markdown Detail Content -->
              <div class="prose prose-zinc max-w-none text-sm text-zinc-700 leading-relaxed mb-8 prose-h3:text-lg prose-h3:font-bold prose-h3:mt-6 prose-ul:my-2">
                <Content />
              </div>

              <!-- Deliverables -->
              <div class="p-6 rounded-xl bg-zinc-50 border border-zinc-200/80 mb-6">
                <h3 class="text-xs font-bold text-zinc-900 uppercase tracking-wider font-mono mb-4">
                  Paket Kapsamı & Somut Çıktılar (Deliverables)
                </h3>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-zinc-700">
                  {service.data.deliverables.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Side Card: Tech & Action -->
            <div class="lg:w-1/3 flex flex-col justify-between p-6 rounded-xl bg-zinc-50/80 border border-zinc-200 space-y-6">
              <div>
                <h4 class="text-xs font-bold text-zinc-900 uppercase tracking-wider font-mono mb-3">
                  Kullanılan Teknolojiler
                </h4>
                <div class="flex flex-wrap gap-1.5">
                  {service.data.techStack.map((tech) => (
                    <span class="px-2.5 py-1 rounded text-xs font-mono bg-white text-zinc-800 border border-zinc-200">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-6 border-t border-zinc-200 space-y-3">
                <div class="text-xs text-zinc-500">
                  İhtiyacınıza göre özelleştirilebilir iş mimarisi.
                </div>
                <a
                  href={`/contact?service=${encodeURIComponent(service.data.title)}`}
                  class="flex items-center justify-center w-full px-4 py-2.5 rounded-lg bg-zinc-950 text-white font-medium text-xs hover:bg-zinc-800 transition-colors shadow-sm"
                >
                  Bu Hizmet İçin İletişime Geçin →
                </a>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Working Process Section -->
    <section class="mt-20 pt-16 border-t border-zinc-200">
      <h2 class="text-2xl sm:text-3xl font-bold text-zinc-950 mb-4">
        Nasıl Birlikte Çalışıyoruz?
      </h2>
      <p class="text-zinc-600 text-sm max-w-xl mb-12">
        Şeffaf, adım adım ilerleyen ve ölçülebilir sonuçlar üreten çalışma modeli.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="p-6 rounded-xl border border-zinc-200 bg-white">
          <div class="text-amber-600 font-mono font-bold text-sm mb-2">01. KEŞİF</div>
          <h3 class="font-bold text-zinc-950 text-base mb-2">Süreç Analizi</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Mevcut araçlarınızı, darboğazlarınızı ve hedeflerinizi 30 dakikalık görüşmede netleştiririz.
          </p>
        </div>

        <div class="p-6 rounded-xl border border-zinc-200 bg-white">
          <div class="text-amber-600 font-mono font-bold text-sm mb-2">02. TASARIM</div>
          <h3 class="font-bold text-zinc-950 text-base mb-2">Mimari Planlama</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            GHL iş akışları, huni şemaları ve entegrasyon haritasını onayınıza sunarım.
          </p>
        </div>

        <div class="p-6 rounded-xl border border-zinc-200 bg-white">
          <div class="text-amber-600 font-mono font-bold text-sm mb-2">03. KURULUM</div>
          <h3 class="font-bold text-zinc-950 text-base mb-2">Uygulama & Test</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Tüm otomasyonları, e-posta şablonlarını ve API bağlantılarını canlı testlerle kurarım.
          </p>
        </div>

        <div class="p-6 rounded-xl border border-zinc-200 bg-white">
          <div class="text-amber-600 font-mono font-bold text-sm mb-2">04. TESLİM</div>
          <h3 class="font-bold text-zinc-950 text-base mb-2">Eğitim & Destek</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Ekibinize sistemin kullanımını video dokümantasyonla aktarır ve destek sağlarım.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
