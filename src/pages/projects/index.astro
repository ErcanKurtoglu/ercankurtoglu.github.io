---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const projects = await getCollection('projects');
const renderedProjects = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return { project, Content };
  })
);
---

<Layout
  title="Özel Projeler & Vaka Analizleri | Ercan Kurtoğlu"
  description="İş otomasyonları, büyük dil modelleri ve özel yazılım mimarileri üzerine gerçekleştirilmiş vaka analizleri."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <header class="border-b border-white/10 pb-12 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-mono font-medium mb-4">
        // PORTFÖY & CASE STUDIES
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-heading">
        Özel Projeler & Çözümler
      </h1>
      <p class="mt-4 text-base sm:text-lg text-zinc-400 max-w-2xl leading-relaxed">
        İşletmelerin operasyonel verimliliğini artıran, manuel iş yükünü sıfırlayan seçilmiş vaka çalışmaları.
      </p>
    </header>

    <div class="space-y-12">
      {renderedProjects.map(({ project, Content }) => (
        <article class="rounded-3xl border border-white/10 bg-white/[0.02] p-8 sm:p-12 hover:border-white/20 transition-all">
          <div class="flex flex-wrap items-center justify-between text-xs text-zinc-400 font-mono mb-4">
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-amber-300 font-medium">
              {project.data.category}
            </span>
            <span>{project.data.year}</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight font-heading mb-4">
            {project.data.title}
          </h2>

          <p class="text-sm sm:text-base text-zinc-400 leading-relaxed mb-8">
            {project.data.description}
          </p>

          <div class="prose prose-invert prose-zinc max-w-none text-sm text-zinc-300 leading-relaxed mb-8 border-t border-white/10 pt-8">
            <Content />
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-white/10">
            <div class="flex flex-wrap gap-2">
              {project.data.tech.map((t) => (
                <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-white/5 text-zinc-300 border border-white/5">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4">
              {project.data.github && (
                <a
                  href={project.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-white hover:text-amber-400 flex items-center gap-1 transition-colors"
                >
                  <span>GitHub Deposu</span> ↗
                </a>
              )}
              {project.data.link && (
                <a
                  href={project.data.link}
                  class="text-xs font-semibold text-white hover:text-amber-400 flex items-center gap-1 transition-colors"
                >
                  <span>Canlı Sistem</span> ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
