---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const projects = await getCollection('projects');
const renderedProjects = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return { project, Content };
  })
);
---

<Layout
  title="Özel Projeler & Vaka Çalışmaları | Ercan"
  description="İş otomasyonları, büyük dil modelleri ve özel yazılım mimarileri üzerine gerçekleştirilmiş vaka analizleri."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <header class="border-b border-zinc-200 pb-10 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200/80 text-amber-800 text-xs font-mono font-medium mb-4">
        PORTFÖY & CASE STUDIES
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-950">
        Özel Projeler & Çözümler
      </h1>
      <p class="mt-4 text-base sm:text-lg text-zinc-600 max-w-2xl font-editorial">
        İşletmelerin operasyonel verimliliğini artıran ve teknik zorlukları çözen seçilmiş çalışmalar.
      </p>
    </header>

    <div class="space-y-12">
      {renderedProjects.map(({ project, Content }) => (
        <article class="rounded-xl border border-zinc-200 bg-white p-8 hover:border-zinc-300 transition-all shadow-sm">
          <div class="flex flex-wrap items-center justify-between text-xs text-zinc-500 font-mono mb-4">
            <span class="px-2.5 py-1 rounded bg-zinc-100 text-zinc-800 font-medium">
              {project.data.category}
            </span>
            <span>{project.data.year}</span>
          </div>

          <h2 class="text-2xl font-bold text-zinc-950 tracking-tight mb-3">
            {project.data.title}
          </h2>

          <p class="text-sm sm:text-base text-zinc-600 leading-relaxed mb-6 font-editorial">
            {project.data.description}
          </p>

          <div class="prose prose-zinc max-w-none text-sm text-zinc-700 leading-relaxed mb-6 border-t border-zinc-100 pt-6">
            <Content />
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-zinc-100">
            <div class="flex flex-wrap gap-1.5">
              {project.data.tech.map((t) => (
                <span class="px-2 py-0.5 rounded text-xs font-mono bg-zinc-100 text-zinc-700">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4">
              {project.data.github && (
                <a
                  href={project.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-zinc-900 hover:text-amber-600 flex items-center gap-1"
                >
                  <span>GitHub'da İncele</span> ↗
                </a>
              )}
              {project.data.link && (
                <a
                  href={project.data.link}
                  class="text-xs font-semibold text-zinc-900 hover:text-amber-600 flex items-center gap-1"
                >
                  <span>Canlı Proje</span> ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
