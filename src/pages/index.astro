---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects.slice(0, 3);

const writings = await getCollection('writing');
const latestWritings = writings.slice(0, 2);

const research = await getCollection('research');
---

<Layout
  title="Ercan Kurtoğlu | Dijital Pazarlama & Akıllı CRM Sistemleri"
  description="İşletmeler için dijital pazarlama altyapısı, satış hunileri, hepsi-bir-arada CRM otomasyonu ve yapay zekâ abonelikleri. Pause or cancel anytime."
>
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION: Responsive Designjoy 2-Column Split                      -->
  <!-- ========================================================================= -->
  <section class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#121212] px-4 sm:px-8 lg:px-12 py-10 sm:py-14 lg:py-16 transition-colors duration-200">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start lg:items-center max-w-full">
      
      <!-- Hero Left: Value Pillars & What We Build (No intrusive CTAs) -->
      <div class="lg:col-span-7 space-y-4 sm:space-y-5">
        <h1 data-i18n="hero.title" class="text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-neutral-900 dark:text-white tracking-tight leading-[1.08] break-words">
          Hantal ajanslar yok. İşletmeniz için hızlı, esnek Dijital Pazarlama ve Akıllı CRM <span class="text-dj-italics text-neutral-700 dark:text-neutral-300">sistemleri</span>
        </h1>

        <p data-i18n="hero.subtitle" class="text-neutral-600 dark:text-neutral-400 text-base sm:text-lg lg:text-xl font-medium pt-1 leading-relaxed">
          Müşteri adaylarını kaçırmayan, randevuları otomatikleştiren ve tüm operasyonunuzu tek panelden yöneten büyüme altyapıları kuruyoruz.
        </p>

        <!-- 3 Core High-Impact Value Pillars (Prominent Titles, Editorial Typography) -->
        <div class="pt-2 sm:pt-3 space-y-3.5 sm:space-y-4">
          <!-- Pillar 1 -->
          <div class="space-y-1 group">
            <div class="flex items-center gap-2 sm:gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-black dark:bg-white shrink-0"></span>
              <h3 data-i18n="hero.p1Title" class="text-base sm:text-lg lg:text-xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
                Otomatik Satış & Randevu Hunileri
              </h3>
            </div>
            <p data-i18n="hero.p1Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-serif italic pl-3.5 sm:pl-4 leading-relaxed">
              “Reklamlardan gelen lead'ler ilk 60 saniyede SMS ve WhatsApp ile karşılanır, takviminiz otomatik dolar.”
            </p>
          </div>

          <!-- Pillar 2 -->
          <div class="space-y-1 group">
            <div class="flex items-center gap-2 sm:gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-black dark:bg-white shrink-0"></span>
              <h3 data-i18n="hero.p2Title" class="text-base sm:text-lg lg:text-xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
                7/24 AI Asistan & Akıllı İş Akışları
              </h3>
            </div>
            <p data-i18n="hero.p2Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-serif italic pl-3.5 sm:pl-4 leading-relaxed">
              “Mesai saatleri dışında bile müşteri sorularını yanıtlayan ve randevu oluşturan otonom sistemler.”
            </p>
          </div>

          <!-- Pillar 3 -->
          <div class="space-y-1 group">
            <div class="flex items-center gap-2 sm:gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-black dark:bg-white shrink-0"></span>
              <h3 data-i18n="hero.p3Title" class="text-base sm:text-lg lg:text-xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
                Uçtan Uca Entegre CRM
              </h3>
            </div>
            <p data-i18n="hero.p3Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-serif italic pl-3.5 sm:pl-4 leading-relaxed">
              “Dağınık Excel ve WhatsApp yerine; lead takibi, müşteri kartları ve ödemeler tek ekranda.”
            </p>
          </div>
        </div>

        <!-- Gentle Flow Indicator -->
        <div class="pt-2">
          <a
            href="#how-it-works"
            class="inline-flex items-center gap-2 text-xs font-semibold text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors group cursor-pointer"
          >
            <span data-i18n="hero.scrollCue">Sistemin nasıl çalıştığını ve vaka analizlerini aşağıda inceleyin ↓</span>
          </a>
        </div>
      </div>

      <!-- Hero Right: Founder Portrait & Architecture Showcase -->
      <div class="lg:col-span-5 w-full">
        <div class="relative w-full max-w-sm sm:max-w-md mx-auto lg:max-w-none rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#fbfbfb] dark:bg-[#181818] p-2.5 sm:p-3.5 shadow-sm transition-colors group">
          
          <!-- Image / Portrait Frame -->
          <div class="relative aspect-[4/5] sm:aspect-[3/4] lg:aspect-[4/5] max-h-[440px] sm:max-h-[480px] w-full rounded-xl sm:rounded-2xl overflow-hidden bg-neutral-200 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-center">

            <!-- Founder Photo (Active once uploaded) -->
            <img
              id="founder-photo"
              src="/images/founder/ercan-kurtoglu.jpg"
              alt="Ercan Kurtoğlu"
              class="w-full h-full object-cover object-top filter grayscale contrast-105 hover:grayscale-0 transition-all duration-700"
              onerror="this.style.display='none'; document.getElementById('founder-photo-placeholder').style.display='flex';"
            />

            <!-- Elegant Fallback Placeholder (Active until image is added) -->
            <div
              id="founder-photo-placeholder"
              class="hidden w-full h-full flex-col items-center justify-center p-6 text-center space-y-3 bg-gradient-to-b from-neutral-100 to-neutral-200 dark:from-[#181818] dark:to-[#121212]"
            >
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-neutral-300 dark:border-neutral-700 flex items-center justify-center bg-white dark:bg-neutral-800 shadow-inner">
                <Logo variant="boxed" className="w-8 h-8 sm:w-10 sm:h-10" />
              </div>
              <div class="space-y-1">
                <div class="text-sm font-bold text-neutral-800 dark:text-neutral-200">Fotoğraf Alanı</div>
                <p class="text-[11px] text-neutral-500 dark:text-neutral-400 max-w-[200px] leading-tight">
                  Ercan Kurtoğlu portre görseli buraya yerleşecek
                </p>
              </div>
            </div>

            <!-- Bottom Gradient & Card Bio Overlay -->
            <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/90 via-black/60 to-transparent p-4 sm:p-5 text-white space-y-1">
              <div class="flex items-center justify-between">
                <div>
                  <div data-i18n="hero.founderName" class="text-base sm:text-lg font-extrabold tracking-tight">
                    Ercan Kurtoğlu
                  </div>
                  <div data-i18n="hero.founderRole" class="text-[11px] sm:text-xs font-mono uppercase tracking-wider text-neutral-300">
                    Kurucu · CRM Mimarı & AI Mühendisi
                  </div>
                </div>
                <Logo variant="boxed" className="w-6 h-6 opacity-80" />
              </div>
              <p data-i18n="hero.founderBio" class="text-[11px] sm:text-xs text-neutral-300 font-normal pt-0.5 line-clamp-2 leading-relaxed">
                Yapay zeka mühendisliği disipliniyle tasarlanmış, yüksek dönüşümlü büyüme altyapıları.
              </p>
            </div>

          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. "THE WAY SYSTEMS SHOULD'VE BEEN DONE" (3 Step Cards)                   -->
  <!-- ========================================================================= -->
  <section id="how-it-works" class="border-b border-neutral-200 dark:border-neutral-800 bg-[#fbfbfb] dark:bg-[#161616] px-4 sm:px-8 lg:px-12 py-16 sm:py-24 lg:py-28 transition-colors duration-200">
    <div class="max-w-4xl mb-12 sm:mb-16">
      <h2 data-i18n="steps.heading" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight leading-[1.15]">
        Sistemlerin en başından beri <span class="text-dj-italics text-neutral-700 dark:text-neutral-300">olması gerektiği</span> gibi
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      <!-- Card 1 -->
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 lg:p-10 hover:shadow-md transition-all">
        <span class="absolute top-3 right-5 sm:top-4 sm:right-6 font-mono text-6xl sm:text-7xl font-black text-neutral-100 dark:text-neutral-800/40 select-none pointer-events-none transition-colors">
          01
        </span>
        <div class="relative z-10">
          <div data-i18n="steps.s1Tag" class="text-[11px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 font-bold mb-3">
            İhtiyaç
          </div>
          <div data-i18n="steps.s1Title" class="text-xl sm:text-2xl font-extrabold text-neutral-900 dark:text-white mb-2">İhtiyacınızı Belirleyin</div>
          <p data-i18n="steps.s1Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans">
            İşletmenizin darboğazına (kaçan lead'ler, randevu takibi veya manuel işler) uygun, ispatlanmış hazır sistem paketlerimizi inceleyin.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 lg:p-10 hover:shadow-md transition-all">
        <span class="absolute top-3 right-5 sm:top-4 sm:right-6 font-mono text-6xl sm:text-7xl font-black text-neutral-100 dark:text-neutral-800/40 select-none pointer-events-none transition-colors">
          02
        </span>
        <div class="relative z-10">
          <div data-i18n="steps.s2Tag" class="text-[11px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 font-bold mb-3">
            Kapsam
          </div>
          <div data-i18n="steps.s2Title" class="text-xl sm:text-2xl font-extrabold text-neutral-900 dark:text-white mb-2">Kapsamı Netleştirelim</div>
          <p data-i18n="steps.s2Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans">
            Kısa ve odaklı bir değerlendirmeyle mevcut araçlarınızı, hedeflerinizi ve entegrasyon yol haritasını birlikte netleştirelim.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 lg:p-10 hover:shadow-md transition-all">
        <span class="absolute top-3 right-5 sm:top-4 sm:right-6 font-mono text-6xl sm:text-7xl font-black text-neutral-100 dark:text-neutral-800/40 select-none pointer-events-none transition-colors">
          03
        </span>
        <div class="relative z-10">
          <div data-i18n="steps.s3Tag" class="text-[11px] font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 font-bold mb-3">
            Entegrasyon
          </div>
          <div data-i18n="steps.s3Title" class="text-xl sm:text-2xl font-extrabold text-neutral-900 dark:text-white mb-2">Hızlı Entegrasyon</div>
          <p data-i18n="steps.s3Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans">
            Denenmiş kampanya ve CRM mimariniz birkaç iş günü içinde anahtar teslim hesabınıza kurulur, test edilir ve yayına alınır.
          </p>
        </div>
      </div>
    </div>

    <!-- Sub-Flow Indicator (Low Friction Transition to Case Studies) -->
    <div class="mt-12 sm:mt-16 text-center">
      <a href="#work" class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors group">
        <span data-i18n="steps.flowCue">Sistemin sahada nasıl sonuç ürettiğini vaka çalışmalarında inceleyin</span>
        <span class="transform group-hover:translate-y-0.5 transition-transform text-base">↓</span>
      </a>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. INFINITE LOGO MARQUEE                                                  -->
  <!-- ========================================================================= -->
  <section class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#121212] py-5 sm:py-6 overflow-hidden transition-colors duration-200 w-full">
    <div class="marquee-mask flex overflow-x-hidden relative w-full">
      <div class="animate-marquee flex items-center gap-10 sm:gap-14 whitespace-nowrap text-neutral-600 dark:text-neutral-400 font-extrabold text-xs sm:text-sm font-sans">
        <span>Akıllı CRM Sistemleri</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>OpenAI API</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Make.com</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Stripe</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Twilio</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Claude 3.5</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Python & FastAPI</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>WhatsApp Business</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <!-- Loop -->
        <span>Akıllı CRM Sistemleri</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>OpenAI API</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Make.com</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Stripe</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Twilio</span>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. RECENT WORK SHOWCASE (Designjoy style)                                  -->
  <!-- ========================================================================= -->
  <section id="work" class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#121212] px-4 sm:px-8 lg:px-12 py-16 sm:py-24 lg:py-28 transition-colors duration-200">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 sm:mb-14 gap-3 sm:gap-4">
      <div>
        <h2 data-i18n="work.heading" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
          Öne Çıkan Çalışmalar
        </h2>
        <p data-i18n="work.sub" class="text-neutral-500 dark:text-neutral-400 text-xs sm:text-sm mt-1 sm:mt-2 font-medium">Uygulanan sistemler ve somut iş çıktıları.</p>
      </div>
      <a href="/projects" data-i18n="work.all" class="text-xs font-bold text-black dark:text-white underline underline-offset-4 hover:text-neutral-700 dark:hover:text-neutral-300">
        Tüm projeler →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {featuredProjects.map((p) => (
        <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#f9fafb] dark:bg-[#181818] p-6 sm:p-8 hover:border-neutral-400 dark:hover:border-neutral-600 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-3">
              <span class="font-bold text-black dark:text-white">{p.data.category}</span>
              <span>{p.data.year}</span>
            </div>
            <h3 class="text-lg sm:text-xl font-extrabold text-neutral-900 dark:text-white mb-2 leading-snug">
              {p.data.title}
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
              {p.data.description}
            </p>
          </div>
          <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
            <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400">{p.data.tech.slice(0, 2).join(', ')}</span>
            <a href="/projects" data-i18n="work.inspect" class="text-xs font-bold text-black dark:text-white hover:underline">İncele →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. "IT'S 'YOU'LL NEVER GO BACK' BETTER" (Membership Perks 6'lı Grid)       -->
  <!-- ========================================================================= -->
  <section id="benefits" class="border-b border-neutral-200 dark:border-neutral-800 bg-[#fbfbfb] dark:bg-[#161616] px-4 sm:px-8 lg:px-12 py-16 sm:py-24 lg:py-32 transition-colors duration-200">
    <div class="max-w-4xl mb-12 sm:mb-16">
      <h2 data-i18n="perks.heading" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight leading-[1.15]">
        Bir kez deneyince <span class="text-dj-italics text-neutral-700 dark:text-neutral-300">"asla geri dönmeyeceğiniz"</span> kalitede
      </h2>
      <p data-i18n="perks.sub" class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base mt-3 sm:mt-4 max-w-xl">
        Karmaşık ajans toplantılarını ve saatlik faturaları geride bırakın.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">⚡️</div>
        <h3 data-i18n="perks.p1Title" class="text-base sm:text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Işık Hızında Teslimat</h3>
        <p data-i18n="perks.p1Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Haftalarca beklemek yok. Hunileriniz ve iş akışlarınız ortalama birkaç iş günü içinde hazır.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">💳</div>
        <h3 data-i18n="perks.p2Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Sabit Paket Ücreti</h3>
        <p data-i18n="perks.p2Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Sürpriz fatura yok. Ne alacağınızı ve ne ödeyeceğinizi baştan bilirsiniz.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">💎</div>
        <h3 data-i18n="perks.p3Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Üst Düzey Kod & Mimari</h3>
        <p data-i18n="perks.p3Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Rastgele şablonlar değil; akademik AI araştırmaları ve kurumsal yazılım disipliniyle inşa edilmiş altyapı.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">🤝</div>
        <h3 data-i18n="perks.p4Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Birebir Kurucu İletişimi</h3>
        <p data-i18n="perks.p4Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Aracı hesap yöneticileri yok. Doğrudan sistemi tasarlayan ve kodu yazan kişiyle konuşursunuz.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">🔒</div>
        <h3 data-i18n="perks.p5Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">%100 Sizin Mülkiyetinizde</h3>
        <p data-i18n="perks.p5Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Tüm CRM hesapları, müşteri verileri ve otomasyon şablonları doğrudan sizin şirketinize aittir.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">🎓</div>
        <h3 data-i18n="perks.p6Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Eğitim & 30 Gün Destek</h3>
        <p data-i18n="perks.p6Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Teslimat sonrası ekibinize özel video dokümantasyonu ve 30 gün öncelikli teknik destek.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 6. "IT'S REALLY JUST ME" (FOUNDER BIO BÖLÜMÜ - Designjoy Brett Card)       -->
  <!-- ========================================================================= -->
  <section id="about" class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#121212] px-4 sm:px-8 lg:px-12 py-16 sm:py-24 lg:py-32 transition-colors duration-200">
    <div class="max-w-5xl mx-auto">
      
      <div class="mb-10 sm:mb-14">
