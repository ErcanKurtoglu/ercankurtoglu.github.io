---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const writings = await getCollection('writing');
const latestWritings = writings
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const projects = await getCollection('projects');
const featuredProjects = projects.slice(0, 2);

const research = await getCollection('research');
const researchCount = research.length;
---

<Layout
  title="Ercan Kurtoğlu | GoHighLevel Otomasyonları, Özel Yazılım & AI Sistem Mimarı"
  description="İşletmeler için anahtar teslim GoHighLevel (GHL) otomasyonları, satış hunileri ve yapay zekâ sistemleri. Hantal ajans süreçleri yok, sabit paketlerle doğrudan sistem mimarı ile çalışın."
>
  <!-- HERO SECTION: High-impact Designjoy aesthetic -->
  <section class="relative pt-16 pb-20 sm:pt-28 sm:pb-32 overflow-hidden">
    <!-- Ambient top glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-amber-500/15 via-amber-500/5 to-transparent blur-[120px] pointer-events-none rounded-full"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-mono text-zinc-300 mb-8 backdrop-blur-md hover:border-amber-500/40 transition-colors">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Kasım ayı için yeni kurulum kontenjanı: <strong class="text-white font-semibold">2 Müsait</strong></span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] font-heading">
        İşletmenizi ölçekleyen <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500 bg-clip-text text-transparent">GoHighLevel & AI</span> sistemleri.
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 sm:mt-8 text-lg sm:text-xl text-zinc-400 max-w-3xl mx-auto leading-relaxed font-normal">
        Hantal ajans toplantılarına ve belirsiz saatlik faturalara son. Satış hunilerinizi, CRM iş akışlarınızı ve kurumsal yapay zekâ entegrasyonlarınızı <strong class="text-zinc-200">sabit paketlerle</strong>, doğrudan kıdemli sistem mimarı ile hayata geçirin.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#pricing"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white text-black font-bold text-sm hover:bg-zinc-200 transition-all shadow-xl shadow-white/10 flex items-center justify-center gap-2 group"
        >
          <span>Paketleri & Fiyatları İncele</span>
          <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white/5 border border-white/10 text-white font-semibold text-sm hover:bg-white/10 hover:border-white/20 transition-all backdrop-blur-md"
        >
          Doğrudan İletişime Geç →
        </a>
      </div>

      <!-- Micro guarantees -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-zinc-400 font-mono">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Sürpriz Maliyet Yok
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Hızlı Teslimat
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Birebir Kurucu İletişimi
        </span>
      </div>
    </div>
  </section>

  <!-- INFINITE MARQUEE: Supported platforms & tech stack -->
  <section class="border-y border-white/10 bg-black/40 py-6 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 mb-3 text-center">
      <span class="text-[11px] font-mono uppercase tracking-widest text-zinc-400">
        Entegre Edilen Sistemler & Teknolojiler
      </span>
    </div>
    
    <div class="flex overflow-x-hidden relative [mask-image:linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]">
      <div class="animate-marquee py-2 flex items-center gap-12 whitespace-nowrap text-zinc-400 font-mono text-sm">
        <span class="flex items-center gap-2"><strong class="text-white">GoHighLevel</strong> (GHL)</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">OpenAI</strong> & Claude API</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Make.com</strong> & Zapier</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Stripe</strong> Payments</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Twilio</strong> SMS & Voice</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Python</strong> & FastAPI</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Supabase</strong> & PostgreSQL</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">WhatsApp</strong> Cloud API</span>
        <span>•</span>
        <!-- Duplicate for infinite effect -->
        <span class="flex items-center gap-2"><strong class="text-white">GoHighLevel</strong> (GHL)</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">OpenAI</strong> & Claude API</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Make.com</strong> & Zapier</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Stripe</strong> Payments</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Twilio</strong> SMS & Voice</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Python</strong> & FastAPI</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">Supabase</strong> & PostgreSQL</span>
        <span>•</span>
        <span class="flex items-center gap-2"><strong class="text-white">WhatsApp</strong> Cloud API</span>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: 3 Simple Steps (Designjoy style) -->
  <section id="how-it-works" class="py-24 sm:py-32 border-b border-white/10 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">
          // ADIM ADIM İLERLEME
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 font-heading">
          Geleneksel ajans karmaşası yok. 3 adımda hayata geçirin.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Step 1 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-8 hover:border-white/20 transition-all relative group">
          <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 text-white font-mono font-bold text-lg flex items-center justify-center mb-6 group-hover:border-amber-500/50 group-hover:text-amber-400 transition-colors">
            01
          </div>
          <h3 class="text-xl font-bold text-white mb-3 font-heading">Paketinizi Seçin</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">
            İhtiyacınıza uygun kurulum veya danışmanlık paketini seçin. Sabit fiyat garantisiyle hemen başlayalım.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-8 hover:border-white/20 transition-all relative group">
          <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 text-white font-mono font-bold text-lg flex items-center justify-center mb-6 group-hover:border-amber-500/50 group-hover:text-amber-400 transition-colors">
            02
          </div>
          <h3 class="text-xl font-bold text-white mb-3 font-heading">Sisteminizi Kuralım</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">
            GHL satış hunileri, otomatik SMS/e-posta iş akışları ve AI ajanları canlı testlerle doğrudan hesabınıza kurulur.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-8 hover:border-white/20 transition-all relative group">
          <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 text-white font-mono font-bold text-lg flex items-center justify-center mb-6 group-hover:border-amber-500/50 group-hover:text-amber-400 transition-colors">
            03
          </div>
          <h3 class="text-xl font-bold text-white mb-3 font-heading">Otomatik Büyüyün</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">
            Potansiyel müşterileriniz otomatik nitelenir, takviminiz dolar, satış süreçleriniz siz uyurken bile çalışır.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SCOPE OF SYSTEMS: What we build (Grid) -->
  <section id="scope" class="py-24 sm:py-32 border-b border-white/10 bg-black/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">
            // ÇÖZÜM ALANLARI & ENTEGRASYONLAR
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 font-heading">
            İşletmeniz için neler inşa ediyorum?
          </h2>
        </div>
        <p class="text-sm text-zinc-400 max-w-md">
          A'dan Z'ye tasarlanmış, test edilmiş ve anahtar teslim çalışan kurumsal otomasyon bileşenleri.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Item 1 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-7 hover:border-white/20 hover:bg-white/[0.04] transition-all">
          <div class="text-amber-400 font-mono text-xs mb-3 font-bold">GHL / SALES FUNNELS</div>
          <h3 class="text-lg font-bold text-white mb-2 font-heading">Yüksek Dönüşümlü Satış Hunileri</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Müşteriyi çeken açılış sayfaları (Landing Pages), A/B testleri, opt-in formları ve dinamik checkout akışları.
          </p>
        </div>

        <!-- Item 2 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-7 hover:border-white/20 hover:bg-white/[0.04] transition-all">
          <div class="text-amber-400 font-mono text-xs mb-3 font-bold">AUTOMATION / WORKFLOWS</div>
          <h3 class="text-lg font-bold text-white mb-2 font-heading">Çok Kanallı Lead Nurturing</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Form dolduran müşteriye ilk 90 saniyede otomatik SMS, WhatsApp ve kişiselleştirilmiş e-posta zincirleri.
          </p>
        </div>

        <!-- Item 3 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-7 hover:border-white/20 hover:bg-white/[0.04] transition-all">
          <div class="text-amber-400 font-mono text-xs mb-3 font-bold">AI / AGENTIC SYSTEMS</div>
          <h3 class="text-lg font-bold text-white mb-2 font-heading">7/24 AI Satış Temsilcisi</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            GHL ile konuşan, müşterinin sorularını şirket verinizle yanıtlayan ve doğrudan takvime randevu bağlayan LLM ajanları.
          </p>
        </div>

        <!-- Item 4 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-7 hover:border-white/20 hover:bg-white/[0.04] transition-all">
          <div class="text-amber-400 font-mono text-xs mb-3 font-bold">CALENDAR / CRM PIPELINE</div>
          <h3 class="text-lg font-bold text-white mb-2 font-heading">Randevu & Kayıp Önleme</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Çift yönlü Google/Outlook takvim senkronu, SMS hatırlatmaları ve gelmeyen müşteriler için otomatik yeniden planlama.
          </p>
        </div>

        <!-- Item 5 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-7 hover:border-white/20 hover:bg-white/[0.04] transition-all">
          <div class="text-amber-400 font-mono text-xs mb-3 font-bold">PAYMENTS & BILLING</div>
          <h3 class="text-lg font-bold text-white mb-2 font-heading">Stripe & İyzico Ödeme Altyapısı</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Tek seferlik ve yinelenen (abonelik) tahsilatları, otomatik e-fatura tetikleyicileri ve başarısız ödeme kurtarma serileri.
          </p>
        </div>

        <!-- Item 6 -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-7 hover:border-white/20 hover:bg-white/[0.04] transition-all">
          <div class="text-amber-400 font-mono text-xs mb-3 font-bold">CUSTOM INTEGRATIONS</div>
          <h3 class="text-lg font-bold text-white mb-2 font-heading">Özel Webhook & REST API Köprüleri</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            GoHighLevel'ı mevcut veritabanınız, dahili yazılımlarınız veya özel yapay zekâ boru hatlarıyla pürüzsüz konuşturma.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SHOWCASE: Recent Case Studies (Designjoy style cards) -->
  <section id="work" class="py-24 sm:py-32 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-16 gap-4">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">
            // SEÇİLMİŞ VAKA ANALİZLERİ
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 font-heading">
            Uygulanan Sistemler & Çıktılar
          </h2>
        </div>
        <a
          href="/projects"
          class="text-xs font-mono font-semibold text-zinc-300 hover:text-white flex items-center gap-1.5 transition-colors group"
        >
          <span>Tüm Proje Arşivini Gör</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {featuredProjects.map((project) => (
          <div class="rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.04] to-transparent p-8 sm:p-10 hover:border-white/20 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-zinc-400 mb-4">
                <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-amber-300 font-medium">
                  {project.data.category}
                </span>
                <span>{project.data.year}</span>
              </div>
              <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-amber-400 transition-colors font-heading">
                {project.data.title}
              </h3>
              <p class="text-sm text-zinc-400 leading-relaxed mb-8">
                {project.data.description}
              </p>
            </div>

            <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap gap-2">
                {project.data.tech.map((t) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-white/5 text-zinc-300 border border-white/5">
                    {t}
                  </span>
                ))}
              </div>
              <a
                href={`/projects`}
                class="text-xs font-semibold text-white group-hover:text-amber-400 flex items-center gap-1 transition-colors"
              >
                Vaka Detayları →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- THE ARCHITECT / BIO SECTION: STRATEGICALLY PLACED BEFORE PRICING  -->
  <!-- ================================================================= -->
  <section id="about" class="py-24 sm:py-32 border-b border-white/10 relative overflow-hidden bg-gradient-to-b from-black via-[#0a0a0c] to-black">
    <!-- Ambient subtle glow behind bio -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-amber-500/10 blur-[140px] pointer-events-none rounded-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="rounded-3xl border border-white/15 bg-white/[0.02] p-8 sm:p-14 backdrop-blur-xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Left: Identity / Portrait Card -->
          <div class="lg:col-span-5 space-y-6">
            <div class="relative rounded-2xl overflow-hidden border border-white/15 bg-gradient-to-br from-zinc-800 to-zinc-950 p-8 text-center flex flex-col items-center">
              <!-- Avatar placeholder with initials -->
              <div class="w-28 h-28 rounded-2xl bg-gradient-to-br from-amber-500 via-amber-600 to-amber-700 text-black flex items-center justify-center font-bold text-4xl shadow-2xl shadow-amber-500/30 mb-6 font-heading">
                EK
              </div>
              <h3 class="text-2xl font-extrabold text-white font-heading">Ercan Kurtoğlu</h3>
              <p class="text-xs font-mono text-amber-400 mt-1">GHL Specialist & AI Researcher</p>
              
              <!-- Badges grid -->
              <div class="mt-6 pt-6 border-t border-white/10 w-full grid grid-cols-2 gap-2 text-left">
                <div class="p-2.5 rounded-lg bg-white/5 border border-white/5">
                  <div class="text-[10px] text-zinc-400 font-mono">MODEL</div>
                  <div class="text-xs font-bold text-white mt-0.5">1-on-1 Direkt</div>
                </div>
                <div class="p-2.5 rounded-lg bg-white/5 border border-white/5">
                  <div class="text-[10px] text-zinc-400 font-mono">UZMANLIK</div>
                  <div class="text-xs font-bold text-white mt-0.5">Uçtan Uca GHL</div>
                </div>
                <div class="p-2.5 rounded-lg bg-white/5 border border-white/5">
                  <div class="text-[10px] text-zinc-400 font-mono">AI DERİNLİĞİ</div>
                  <div class="text-xs font-bold text-white mt-0.5">Akademik & Kod</div>
                </div>
                <div class="p-2.5 rounded-lg bg-white/5 border border-white/5">
                  <div class="text-[10px] text-zinc-400 font-mono">SÖZLEŞME</div>
                  <div class="text-xs font-bold text-white mt-0.5">Sabit Fiyat</div>
                </div>
              </div>
            </div>

            <!-- Fast channel -->
            <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex items-center justify-between text-xs">
              <span class="text-zinc-400">Doğrudan İletişim:</span>
              <a href="mailto:iletisim@ercankurtoglu.site" class="font-mono text-amber-400 hover:text-amber-300 font-semibold">
                iletisim@ercankurtoglu.site
              </a>
            </div>
          </div>

          <!-- Right: The Story & Philosophy -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-mono">
              // KİMİNLE ÇALIŞIYORSUNUZ?
            </div>

            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight font-heading">
              Aracı ajanslar veya stajyerler yok. <br />
              <span class="text-zinc-400">Doğrudan sistem mimarı ile birebir çalışın.</span>
            </h2>

            <p class="text-base text-zinc-300 leading-relaxed font-normal">
              Geleneksel ajanslarda satış görüşmesini bir yöneticiyle yapar, ardından projenizin arka planda stajyerlere ya da junior çalışanlara delege edildiğini görürsünüz. İletişim kopar, teslimatlar aksar.
            </p>

            <p class="text-sm text-zinc-400 leading-relaxed">
              Ben bu süreci tersine çeviriyorum: <strong>Bir yanda GoHighLevel</strong> ve satış hunilerini işletmelerin gelirini artırmak için kurgulayan bir iş mimarı; <strong>diğer yanda büyük dil modellerinde muhakeme sistemleri</strong> üzerine akademik araştırmalar yürüten bir yapay zekâ geliştiricisiyim.
            </p>

            <p class="text-sm text-zinc-400 leading-relaxed">
              Bu hibrit bakış açısı sayesinde işletmenize sadece rastgele bir "hazır şablon" değil; ölçeklenebilir, hatasız ve kurumsal yazılım standartlarında bir altyapı kazandırıyorum.
            </p>

            <!-- Links to academic & writing -->
            <div class="pt-6 border-t border-white/10 flex flex-wrap items-center gap-4">
              <a
                href="/research"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-white/10 text-white hover:bg-white/20 text-xs font-semibold transition-colors"
              >
                <span>Akademik Araştırmalarımı İncele ({researchCount})</span>
                <span class="text-amber-400">→</span>
              </a>
              <a
                href="/writing"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-white/10 text-zinc-300 hover:text-white text-xs font-semibold transition-colors"
              >
                <span>Teknik Yazılar & Dergi</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
