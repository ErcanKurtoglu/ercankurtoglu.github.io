---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const writings = await getCollection('writing');
const latestWritings = writings
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const projects = await getCollection('projects');
const featuredProjects = projects.slice(0, 3);

const research = await getCollection('research');
---

<Layout
  title="Ercan Kurtoğlu | GoHighLevel Otomasyonları & AI Sistem Mimarı"
  description="İşletmeler için anahtar teslim GoHighLevel (GHL) otomasyonları, satış hunileri ve yapay zekâ sistemleri. Hantal ajans süreçleri yok, sabit paketlerle doğrudan sistem mimarı ile çalışın."
>
  <!-- HERO SECTION: Exact Designjoy layout & aesthetic -->
  <section class="relative pt-20 pb-24 sm:pt-32 sm:pb-36 bg-[#ffffff] border-b border-neutral-200/80">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Designjoy pill badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-neutral-100 border border-neutral-200/80 text-xs font-semibold text-neutral-800 mb-8 shadow-sm">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Kasım ayı için yeni kurulum kontenjanı: <strong>2 Müsait</strong></span>
      </div>

      <!-- Main Designjoy Heading (Figtree heavy) -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-neutral-900 leading-[1.08] max-w-4xl mx-auto">
        İşletmenizi ölçekleyen <br class="hidden sm:inline" />
        <span class="underline decoration-neutral-300 decoration-wavy underline-offset-8">GoHighLevel & AI</span> sistemleri.
      </h1>

      <!-- Subtitle -->
      <p class="mt-8 text-lg sm:text-xl text-neutral-600 max-w-2xl mx-auto leading-relaxed">
        Hantal ajans süreçlerine ve belirsiz saatlik faturalara son. Satış hunilerinizi, CRM iş akışlarınızı ve yapay zekâ entegrasyonlarınızı sabit paketlerle doğrudan kurucu sistem mimarı ile hayata geçirin.
      </p>

      <!-- Designjoy Dual Pill Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#pricing"
          class="w-full sm:w-auto px-9 py-4 rounded-full bg-black text-white font-bold text-sm hover:bg-neutral-800 transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2 group"
        >
          <span>Planları & Fiyatları Gör</span>
          <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto px-9 py-4 rounded-full bg-white border border-neutral-300 text-neutral-900 font-bold text-sm hover:bg-neutral-50 transition-all shadow-sm"
        >
          15 Dk Görüşme Planla →
        </a>
      </div>

      <!-- Social Proof / Stars -->
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4 text-xs text-neutral-500 font-medium">
        <div class="flex items-center text-amber-500 text-sm tracking-widest">
          ★★★★★
        </div>
        <span>Kurumsal standartlarda anahtar teslim teslimat garantisi</span>
      </div>
    </div>
  </section>

  <!-- INFINITE TICKER (Designjoy Logo Marquee) -->
  <section class="border-b border-neutral-200/80 bg-neutral-50/50 py-7 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 mb-4 text-center">
      <span class="text-xs font-mono font-bold uppercase tracking-widest text-neutral-400">
        // ENTEGRE EDİLEN RESMİ SİSTEMLER & TEKNOLOJİLER
      </span>
    </div>
    
    <div class="flex overflow-x-hidden relative [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
      <div class="animate-marquee py-2 flex items-center gap-14 whitespace-nowrap text-neutral-600 font-semibold text-sm">
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">GoHighLevel</strong> (GHL)</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">OpenAI</strong> API</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Make.com</strong></span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Stripe</strong> Payments</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Twilio</strong> SMS</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Claude</strong> 3.5</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Python</strong> & FastAPI</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Supabase</strong></span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">WhatsApp</strong> Business</span>
        <span class="text-neutral-300">•</span>
        <!-- Duplicate for loop -->
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">GoHighLevel</strong> (GHL)</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">OpenAI</strong> API</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Make.com</strong></span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Stripe</strong> Payments</span>
        <span class="text-neutral-300">•</span>
        <span class="flex items-center gap-2"><strong class="text-black font-extrabold">Twilio</strong> SMS</span>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: 3 Steps (Designjoy style) -->
  <section id="how-it-works" class="py-24 sm:py-32 border-b border-neutral-200/80 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">
          // NASIL ÇALIŞIR?
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 mt-3 tracking-tight">
          Haftalar süren toplantılar yok. <br />
          Sisteminizi 3 adımda kurun.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Step 1 -->
        <div class="rounded-3xl border border-neutral-200 bg-[#fafafa] p-8 sm:p-10 hover:border-neutral-400 hover:shadow-md transition-all relative">
          <div class="w-12 h-12 rounded-2xl bg-black text-white font-extrabold text-lg flex items-center justify-center mb-6">
            1
          </div>
          <h3 class="text-2xl font-extrabold text-neutral-900 mb-3">Paketinizi Seçin</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            İhtiyacınıza uygun GHL kurulum veya tam AI otomasyon planını seçin. Sabit fiyat garantisiyle aynı gün başlayalım.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="rounded-3xl border border-neutral-200 bg-[#fafafa] p-8 sm:p-10 hover:border-neutral-400 hover:shadow-md transition-all relative">
          <div class="w-12 h-12 rounded-2xl bg-black text-white font-extrabold text-lg flex items-center justify-center mb-6">
            2
          </div>
          <h3 class="text-2xl font-extrabold text-neutral-900 mb-3">Sisteminizi Teslim Alın</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Satış hunileri, SMS/e-posta iş akışları ve AI randevu asistanları doğrudan kendi GHL hesabınıza anahtar teslim kurulur.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="rounded-3xl border border-neutral-200 bg-[#fafafa] p-8 sm:p-10 hover:border-neutral-400 hover:shadow-md transition-all relative">
          <div class="w-12 h-12 rounded-2xl bg-black text-white font-extrabold text-lg flex items-center justify-center mb-6">
            3
          </div>
          <h3 class="text-2xl font-extrabold text-neutral-900 mb-3">Otomatik Büyüyün</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Lead'leriniz otomatik karşılanır, takviminiz dolar, satış süreçleriniz siz müdahale etmeden kusursuz çalışır.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- MEMBERSHIP BENEFITS / PERKS GRID (Designjoy's signature 6 cards) -->
  <section id="benefits" class="py-24 sm:py-32 border-b border-neutral-200/80 bg-[#fbfbfb]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">
          // AVANTAJLAR
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 mt-3 tracking-tight">
          Neden geleneksel ajanslardan farklı?
        </h2>
        <p class="mt-4 text-base text-neutral-600">
          Saatlik sayaç çalıştıran ajansların aksine, tamamen sonuç ve şeffaflık odaklı bir çalışma modeli.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Perk 1 -->
        <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:border-neutral-400 hover:shadow-lg transition-all">
          <div class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center text-xl mb-6">
            ⚡️
          </div>
          <h3 class="text-xl font-extrabold text-neutral-900 mb-2">Hızlı Teslimat</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Haftalar süren bürokratik onaylar yok. İş akışlarınız ve hunileriniz ortalama birkaç gün içinde canlı testleriyle hazır.
          </p>
        </div>

        <!-- Perk 2 -->
        <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:border-neutral-400 hover:shadow-lg transition-all">
          <div class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center text-xl mb-6">
            💳
          </div>
          <h3 class="text-xl font-extrabold text-neutral-900 mb-2">Sabit Paket Fiyatı</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Sürpriz fatura veya sonradan çıkan gizli masraflar yok. Ne alacağınızı ve ne ödeyeceğinizi baştan bilirsiniz.
          </p>
        </div>

        <!-- Perk 3 -->
        <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:border-neutral-400 hover:shadow-lg transition-all">
          <div class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center text-xl mb-6">
            💎
          </div>
          <h3 class="text-xl font-extrabold text-neutral-900 mb-2">Üst Düzey Mimari Kalitesi</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Rastgele hazır şablonlar değil; akademik AI araştırmaları ve kurumsal yazılım disipliniyle inşa edilmiş ölçeklenebilir altyapı.
          </p>
        </div>

        <!-- Perk 4 -->
        <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:border-neutral-400 hover:shadow-lg transition-all">
          <div class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center text-xl mb-6">
            🤝
          </div>
          <h3 class="text-xl font-extrabold text-neutral-900 mb-2">Birebir Kurucu İletişimi</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Aracı hesap yöneticileri yok. Sorularınızı doğrudan kodu yazan ve sistemi kuran kişiye sorarsınız.
          </p>
        </div>

        <!-- Perk 5 -->
        <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:border-neutral-400 hover:shadow-lg transition-all">
          <div class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center text-xl mb-6">
            🔒
          </div>
          <h3 class="text-xl font-extrabold text-neutral-900 mb-2">%100 Sizin Mülkiyetinizde</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Tüm GoHighLevel hesabı, müşteri verileri, API anahtarları ve şablonlar doğrudan sizin şirketinize aittir.
          </p>
        </div>

        <!-- Perk 6 -->
        <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:border-neutral-400 hover:shadow-lg transition-all">
          <div class="w-12 h-12 rounded-2xl bg-neutral-100 flex items-center justify-center text-xl mb-6">
            🎓
          </div>
          <h3 class="text-xl font-extrabold text-neutral-900 mb-2">Eğitim & 30 Gün Destek</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Teslimat sonrası ekibinize özel Loom video dokümantasyonu ve 30 gün boyunca kesintisiz öncelikli teknik destek.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RECENT WORK SHOWCASE (Designjoy style cards) -->
  <section id="work" class="py-24 sm:py-32 border-b border-neutral-200/80 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-16 gap-4">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">
            // SEÇİLMİŞ VAKA ANALİZLERİ
          </span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 mt-2 tracking-tight">
            Uygulanan Sistemler & Çıktılar
          </h2>
        </div>
        <a
          href="/projects"
          class="text-sm font-bold text-neutral-900 hover:text-black flex items-center gap-1 transition-colors group"
        >
          <span>Tüm Projeleri İncele</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {featuredProjects.map((project) => (
          <div class="rounded-3xl border border-neutral-200 bg-[#fafafa] p-8 sm:p-10 hover:border-neutral-400 hover:shadow-lg transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-neutral-500 mb-4">
                <span class="px-3 py-1 rounded-full bg-white border border-neutral-200 text-neutral-800 font-bold">
                  {project.data.category}
                </span>
                <span>{project.data.year}</span>
              </div>
              <h3 class="text-2xl font-extrabold text-neutral-900 mb-3 group-hover:text-black transition-colors leading-snug">
                {project.data.title}
              </h3>
              <p class="text-sm text-neutral-600 leading-relaxed mb-8">
                {project.data.description}
              </p>
            </div>

            <div class="pt-6 border-t border-neutral-200 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap gap-1.5">
                {project.data.tech.slice(0, 3).map((t) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-white text-neutral-700 border border-neutral-200">
                    {t}
                  </span>
                ))}
              </div>
              <a
                href="/projects"
                class="text-xs font-extrabold text-neutral-900 group-hover:underline flex items-center gap-1"
              >
                İncele →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- "IT'S REALLY JUST ME" / THE FOUNDER BIO (Exact Designjoy Brett section)    -->
  <!-- ========================================================================= -->
  <section id="about" class="py-24 sm:py-32 border-b border-neutral-200/80 bg-[#f9fafb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-14 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Left: Identity / Portrait Card (Designjoy style) -->
          <div class="lg:col-span-5 space-y-6">
            <div class="rounded-2xl border border-neutral-200 bg-[#fafafa] p-8 text-center flex flex-col items-center shadow-inner">
              <!-- Big Initial Avatar -->
              <div class="w-28 h-28 rounded-2xl bg-black text-white flex items-center justify-center font-extrabold text-4xl shadow-xl mb-6">
                EK
              </div>
              <h3 class="text-2xl font-extrabold text-neutral-900">Ercan Kurtoğlu</h3>
              <p class="text-xs font-mono font-bold text-neutral-500 mt-1">Founder, System & AI Architect</p>
              
              <!-- 4 Badges Grid -->
              <div class="mt-6 pt-6 border-t border-neutral-200 w-full grid grid-cols-2 gap-2 text-left">
                <div class="p-3 rounded-xl bg-white border border-neutral-200">
                  <div class="text-[10px] text-neutral-400 font-mono font-bold">MODEL</div>
                  <div class="text-xs font-extrabold text-neutral-900 mt-0.5">1-on-1 Doğrudan</div>
                </div>
                <div class="p-3 rounded-xl bg-white border border-neutral-200">
                  <div class="text-[10px] text-neutral-400 font-mono font-bold">UZMANLIK</div>
                  <div class="text-xs font-extrabold text-neutral-900 mt-0.5">Uçtan Uca GHL</div>
                </div>
                <div class="p-3 rounded-xl bg-white border border-neutral-200">
                  <div class="text-[10px] text-neutral-400 font-mono font-bold">AI DERİNLİĞİ</div>
                  <div class="text-xs font-extrabold text-neutral-900 mt-0.5">Akademik & Kod</div>
                </div>
                <div class="p-3 rounded-xl bg-white border border-neutral-200">
                  <div class="text-[10px] text-neutral-400 font-mono font-bold">FİYAT</div>
                  <div class="text-xs font-extrabold text-neutral-900 mt-0.5">Sabit Paket</div>
                </div>
              </div>
            </div>

            <!-- Email box -->
            <div class="p-4 rounded-2xl bg-neutral-100 border border-neutral-200 flex items-center justify-between text-xs font-mono">
              <span class="text-neutral-500">Doğrudan İletişim:</span>
              <a href="mailto:iletisim@ercankurtoglu.site" class="text-neutral-900 font-bold hover:underline">
                iletisim@ercankurtoglu.site
              </a>
            </div>
          </div>

          <!-- Right: The Story & Designjoy philosophy -->
          <div class="lg:col-span-7 space-y-6">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">
              // KİMİNLE ÇALIŞIYORSUNUZ?
            </span>

            <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 tracking-tight leading-tight">
              Aracı ajanslar veya stajyerler yok. <br />
              <span class="text-neutral-500">Doğrudan sistem mimarı ile çalışın.</span>
            </h2>

            <p class="text-base text-neutral-700 leading-relaxed font-normal">
              Geleneksel ajanslarda satış görüşmesini üst düzey bir yöneticiyle yaparsınız, ancak proje başladıktan sonra işlerinizin arka planda stajyerlere ya da junior çalışanlara devredildiğini görürsünüz. İletişim kopar, teslimatlar gecikir.
            </p>

            <p class="text-sm text-neutral-600 leading-relaxed">
              <strong>Ben bu süreci tamamen ortadan kaldırıyorum:</strong> Bir yanda GoHighLevel ve satış hunilerini işletmelerin gelirini artırmak için kurgulayan bir iş mimarı; diğer yanda büyük dil modellerinde mantıksal muhakeme üzerine akademik araştırmalar yürüten bir yapay zekâ mühendisiyim.
            </p>

            <p class="text-sm text-neutral-600 leading-relaxed">
              Bu hibrit yapı sayesinde işletmeniz yalnızca rastgele hazır şablonlar değil; ölçeklenebilir, hatasız ve kurumsal yazılım standartlarında bir büyüme motoru kazanır.
            </p>

            <!-- Links to academic & writing -->
            <div class="pt-6 border-t border-neutral-200 flex flex-wrap items-center gap-4">
              <a
                href="/research"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-black text-white hover:bg-neutral-800 text-xs font-bold transition-all"
              >
                <span>Akademik Araştırmalarımı Gör ({research.length})</span>
                <span>→</span>
              </a>
              <a
                href="/writing"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white border border-neutral-300 text-neutral-900 hover:bg-neutral-50 text-xs font-bold transition-all"
              >
                <span>Teknik Yazılar & Blog</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- SCOPE OF WORK (Designjoy's apps list) -->
  <section id="scope" class="py-24 sm:py-32 border-b border-neutral-200/80 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">
            // HİZMET KAPSAMI
          </span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 mt-2 tracking-tight">
            Neler kuruyoruz?
          </h2>
        </div>
        <p class="text-sm text-neutral-600 max-w-md">
          İşletmenizin satış, pazarlama ve operasyon süreçlerini uçtan uca otomatize eden kurumsal bileşenler.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-6 rounded-2xl border border-neutral-200 bg-[#fafafa]">
          <div class="text-black font-extrabold text-sm mb-1">Satış Hunileri (Funnels)</div>
          <div class="text-xs text-neutral-500 leading-relaxed">Açılış sayfaları, opt-in formları, A/B testleri</div>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-200 bg-[#fafafa]">
          <div class="text-black font-extrabold text-sm mb-1">Lead Nurturing (SMS & Mail)</div>
          <div class="text-xs text-neutral-500 leading-relaxed">İlk 90 saniyede otomatik karşılama serileri</div>
        </div>

