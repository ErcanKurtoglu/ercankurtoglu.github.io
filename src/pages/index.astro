---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects.slice(0, 3);

const writings = await getCollection('writing');
const latestWritings = writings.slice(0, 2);

const research = await getCollection('research');
---

<Layout
  title="Ercan Kurtoğlu | GoHighLevel & AI Subscriptions"
  description="GoHighLevel iş sistemleri kurulumu, satış hunileri ve yapay zekâ abonelikleri. Pause or cancel anytime."
>
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION: Exact Designjoy 2-Column Split                           -->
  <!-- ========================================================================= -->
  <section class="border-b border-neutral-200 bg-white px-6 sm:px-12 py-16 sm:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Hero Left -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Available status badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-neutral-100 border border-neutral-200 text-xs font-bold text-neutral-800">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Kasım ayı için yeni kurulum: <strong>2 Müsait</strong></span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-neutral-900 tracking-tight leading-[1.05]">
          GoHighLevel & AI subscriptions for <span class="text-dj-italics text-neutral-700">everyone</span>
        </h1>

        <p class="text-neutral-500 text-lg sm:text-xl font-medium pt-2">
          Pause or cancel anytime. <span class="text-neutral-400 font-normal">Hantal ajans süreçleri yok.</span>
        </p>

        <!-- Buttons -->
        <div class="pt-4 flex flex-wrap items-center gap-3">
          <a
            href="#pricing"
            class="px-8 py-4 rounded-full bg-black text-white font-bold text-sm hover:bg-neutral-800 transition-all shadow-md"
          >
            See pricing
          </a>
          <a
            href="/contact"
            class="px-8 py-4 rounded-full bg-white border border-neutral-300 text-neutral-900 font-bold text-sm hover:bg-neutral-50 transition-colors shadow-sm"
          >
            Book a call
          </a>
        </div>
      </div>

      <!-- Hero Right: The Designjoy Member Card Mockup -->
      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-neutral-200 bg-[#f9fafb] p-8 sm:p-10 shadow-sm relative overflow-hidden space-y-8">
          
          <div class="space-y-2">
            <span class="text-[11px] font-mono uppercase tracking-widest text-neutral-400 font-bold block">
              SYSTEM ARCHITECTURE
            </span>
            <div class="text-3xl sm:text-4xl font-extrabold text-neutral-900 leading-none">
              Ercan Kurtoğlu
            </div>
            <p class="text-xs text-neutral-500 font-medium pt-1">
              One subscription to automate them all.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-neutral-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between text-xs font-bold text-neutral-900 border-b border-neutral-100 pb-3">
              <span>Kurulum & Otomasyon</span>
              <span class="text-emerald-600 font-mono">Aktif</span>
            </div>
            <ul class="space-y-2 text-xs text-neutral-600">
              <li class="flex items-center gap-2">
                <span class="text-black font-bold">✓</span>
                <span>Uçtan Uca GoHighLevel CRM</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-black font-bold">✓</span>
                <span>7/24 AI Randevu Asistanı</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-black font-bold">✓</span>
                <span>Özel Make & Zapier Köprüleri</span>
              </li>
            </ul>
          </div>

          <!-- Bottom Schedule Bar -->
          <a
            href="/contact"
            class="flex items-center justify-between p-4 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-400 hover:shadow-md transition-all text-xs font-bold text-neutral-900"
          >
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-black text-white flex items-center justify-center text-xs">
                📞
              </div>
              <div>
                <div>15-dakikalık tanışma seansı</div>
                <div class="text-[11px] text-neutral-400 font-normal">Schedule now</div>
              </div>
            </div>
            <span class="text-neutral-400">→</span>
          </a>

        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. "THE WAY SYSTEMS SHOULD'VE BEEN DONE" (3 Step Cards)                   -->
  <!-- ========================================================================= -->
  <section id="how-it-works" class="border-b border-neutral-200 bg-[#fbfbfb] px-6 sm:px-12 py-20 sm:py-28">
    <div class="max-w-4xl mb-16">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 tracking-tight leading-[1.1]">
        The way systems <span class="text-dj-italics text-neutral-700">should’ve</span> been done in the first place
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Card 1 -->
      <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:shadow-md transition-all">
        <div class="text-2xl font-extrabold text-neutral-900 mb-2">Subscribe</div>
        <p class="text-sm text-neutral-600 leading-relaxed">
          Bir plana abone olun veya tek seferlik kurulum paketinizi seçin. Sürpriz ek maliyet olmadan hemen başlayalım.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:shadow-md transition-all">
        <div class="text-2xl font-extrabold text-neutral-900 mb-2">Request</div>
        <p class="text-sm text-neutral-600 leading-relaxed">
          Satış hunisi, SMS iş akışı, AI randevu botu veya ödeme entegrasyonu... İhtiyacınız olan her sistemi talep edin.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="rounded-3xl border border-neutral-200 bg-white p-8 sm:p-10 hover:shadow-md transition-all">
        <div class="text-2xl font-extrabold text-neutral-900 mb-2">Receive</div>
        <p class="text-sm text-neutral-600 leading-relaxed">
          Sistemleriniz canlı testleriyle birlikte birkaç iş günü içinde doğrudan hesabınıza teslim edilir.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. INFINITE LOGO MARQUEE                                                  -->
  <!-- ========================================================================= -->
  <section class="border-b border-neutral-200 bg-white py-6 overflow-hidden">
    <div class="flex overflow-x-hidden relative [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
      <div class="animate-marquee flex items-center gap-14 whitespace-nowrap text-neutral-600 font-extrabold text-sm font-sans">
        <span>GoHighLevel (GHL)</span>
        <span class="text-neutral-300">•</span>
        <span>OpenAI API</span>
        <span class="text-neutral-300">•</span>
        <span>Make.com</span>
        <span class="text-neutral-300">•</span>
        <span>Stripe</span>
        <span class="text-neutral-300">•</span>
        <span>Twilio</span>
        <span class="text-neutral-300">•</span>
        <span>Claude 3.5</span>
        <span class="text-neutral-300">•</span>
        <span>Python & FastAPI</span>
        <span class="text-neutral-300">•</span>
        <span>WhatsApp Business</span>
        <span class="text-neutral-300">•</span>
        <!-- Loop -->
        <span>GoHighLevel (GHL)</span>
        <span class="text-neutral-300">•</span>
        <span>OpenAI API</span>
        <span class="text-neutral-300">•</span>
        <span>Make.com</span>
        <span class="text-neutral-300">•</span>
        <span>Stripe</span>
        <span class="text-neutral-300">•</span>
        <span>Twilio</span>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. RECENT WORK SHOWCASE (Designjoy style)                                  -->
  <!-- ========================================================================= -->
  <section id="work" class="border-b border-neutral-200 bg-white px-6 sm:px-12 py-20 sm:py-28">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-14 gap-4">
      <div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 tracking-tight">
          Recent work
        </h2>
        <p class="text-neutral-500 text-sm mt-2 font-medium">Uygulanan sistemler ve somut iş çıktıları.</p>
      </div>
      <a href="/projects" class="text-xs font-bold text-black underline underline-offset-4 hover:text-neutral-700">
        Tüm projeler →
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {featuredProjects.map((p) => (
        <div class="rounded-3xl border border-neutral-200 bg-[#f9fafb] p-8 hover:border-neutral-400 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-neutral-500 mb-3">
              <span class="font-bold text-black">{p.data.category}</span>
              <span>{p.data.year}</span>
            </div>
            <h3 class="text-xl font-extrabold text-neutral-900 mb-2 leading-snug">
              {p.data.title}
            </h3>
            <p class="text-xs text-neutral-600 leading-relaxed mb-6">
              {p.data.description}
            </p>
          </div>
          <div class="pt-4 border-t border-neutral-200 flex items-center justify-between">
            <span class="text-[11px] font-mono text-neutral-500">{p.data.tech.slice(0, 2).join(', ')}</span>
            <a href="/projects" class="text-xs font-bold text-black hover:underline">İncele →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. "IT'S 'YOU'LL NEVER GO BACK' BETTER" (Membership Perks 6'lı Grid)       -->
  <!-- ========================================================================= -->
  <section id="benefits" class="border-b border-neutral-200 bg-[#fbfbfb] px-6 sm:px-12 py-20 sm:py-32">
    <div class="max-w-4xl mb-16">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 tracking-tight leading-[1.1]">
        It's <span class="text-dj-italics text-neutral-700">"you'll never go back"</span> better
      </h2>
      <p class="text-neutral-600 text-base mt-4 max-w-xl">
        Karmaşık ajans toplantılarını ve saatlik faturaları geride bırakın.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="rounded-3xl border border-neutral-200 bg-white p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-4">⚡️</div>
        <h3 class="text-lg font-extrabold text-neutral-900 mb-2">Işık Hızında Teslimat</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Haftalarca beklemek yok. Hunileriniz ve iş akışlarınız ortalama birkaç iş günü içinde hazır.
        </p>
      </div>

      <div class="rounded-3xl border border-neutral-200 bg-white p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-4">💳</div>
        <h3 class="text-lg font-extrabold text-neutral-900 mb-2">Sabit Paket Ücreti</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Sürpriz fatura yok. Ne alacağınızı ve ne ödeyeceğinizi baştan bilirsiniz.
        </p>
      </div>

      <div class="rounded-3xl border border-neutral-200 bg-white p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-4">💎</div>
        <h3 class="text-lg font-extrabold text-neutral-900 mb-2">Üst Düzey Kod & Mimari</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Rastgele şablonlar değil; akademik AI araştırmaları ve kurumsal yazılım disipliniyle inşa edilmiş altyapı.
        </p>
      </div>

      <div class="rounded-3xl border border-neutral-200 bg-white p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-4">🤝</div>
        <h3 class="text-lg font-extrabold text-neutral-900 mb-2">Birebir Kurucu İletişimi</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Aracı hesap yöneticileri yok. Doğrudan sistemi tasarlayan ve kodu yazan kişiyle konuşursunuz.
        </p>
      </div>

      <div class="rounded-3xl border border-neutral-200 bg-white p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-4">🔒</div>
        <h3 class="text-lg font-extrabold text-neutral-900 mb-2">%100 Sizin Mülkiyetinizde</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Tüm GoHighLevel hesabı, müşteri verileri ve şablonlar doğrudan sizin şirketinize aittir.
        </p>
      </div>

      <div class="rounded-3xl border border-neutral-200 bg-white p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-4">🎓</div>
        <h3 class="text-lg font-extrabold text-neutral-900 mb-2">Eğitim & 30 Gün Destek</h3>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Teslimat sonrası ekibinize özel video dokümantasyonu ve 30 gün öncelikli teknik destek.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 6. "IT'S REALLY JUST ME" (FOUNDER BIO BÖLÜMÜ - Designjoy Brett Card)       -->
  <!-- ========================================================================= -->
  <section id="about" class="border-b border-neutral-200 bg-white px-6 sm:px-12 py-20 sm:py-32">
    <div class="max-w-5xl mx-auto">
      
      <div class="mb-14">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 tracking-tight leading-[1.1]">
          It's <span class="text-dj-italics text-neutral-700">really just me</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center rounded-3xl border border-neutral-200 bg-[#f9fafb] p-8 sm:p-12">
        
        <!-- Left: Founder Card -->
        <div class="lg:col-span-5 text-center flex flex-col items-center space-y-4">
          <div class="w-32 h-32 rounded-3xl bg-black text-white flex items-center justify-center font-extrabold text-4xl shadow-xl">
            EK
          </div>
          <div>
            <h3 class="text-2xl font-extrabold text-neutral-900">Ercan Kurtoğlu</h3>
            <p class="text-xs text-neutral-500 font-mono font-bold mt-0.5">Founder, System & AI Architect</p>
          </div>
          <div class="w-full pt-4 border-t border-neutral-200 text-xs text-neutral-600 space-y-1 text-left font-medium">
            <div>• Uçtan Uca GoHighLevel Mimarisi</div>
            <div>• Büyük Dil Modelleri & AI Ajanları</div>
            <div>• Doğrudan 1-on-1 İletişim</div>
          </div>
        </div>

        <!-- Right: Story -->
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg font-bold text-neutral-900 leading-snug">
            Merhaba, ben Ercan. Aracı ajanslar, karmaşık toplantılar veya stajyerler yok. Doğrudan benimle birebir çalışıyorsunuz.
          </p>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Bir yanda GoHighLevel sistemlerini gelir üreten otomatik satış makinelerine dönüştüren bir sistem mimarı; diğer yanda büyük dil modellerinde mantıksal muhakeme ve doğrulama üzerine çalışan bir yapay zekâ araştırmacısıyım.
          </p>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Bu hibrit bakış açısı sayesinde işletmeniz yalnızca rastgele şablonlar değil; ölçeklenebilir, hatasız ve kurumsal yazılım standartlarında bir büyüme altyapısı kazanır.
          </p>
          <div class="pt-4 flex flex-wrap items-center gap-3">
            <a href="/research" class="px-5 py-2.5 rounded-full bg-black text-white text-xs font-bold hover:bg-neutral-800 transition-colors">
              Akademik Çalışmalarım ({research.length}) →
            </a>
            <a href="/writing" class="px-5 py-2.5 rounded-full border border-neutral-300 text-black text-xs font-bold hover:bg-white transition-colors">
              Teknik Yazılarım →
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 7. SCOPE OF SYSTEMS (Apps we build)                                       -->
  <!-- ========================================================================= -->
  <section class="border-b border-neutral-200 bg-[#fbfbfb] px-6 sm:px-12 py-20 sm:py-28">
    <div class="max-w-4xl mb-14">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 tracking-tight leading-[1.1]">
        Apps & systems <span class="text-dj-italics text-neutral-700">we build</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-extrabold text-neutral-900">
      <div class="p-5 rounded-2xl bg-white border border-neutral-200">Satış Hunileri (Funnels)</div>
      <div class="p-5 rounded-2xl bg-white border border-neutral-200">Lead Nurturing (SMS/Mail)</div>
      <div class="p-5 rounded-2xl bg-white border border-neutral-200">7/24 AI Randevu Ajanları</div>
      <div class="p-5 rounded-2xl bg-white border border-neutral-200">Takvim & Randevu Senkronu</div>
      <div class="p-5 rounded-2xl bg-white border border-neutral-200">Stripe & İyzico Ödemeleri</div>
      <div class="p-5 rounded-2xl bg-white border border-neutral-200">Özel Webhook & REST API</div>
      <div class="p-5 rounded-2xl bg-white border border-neutral-200">WhatsApp Cloud API</div>
      <div class="p-5 rounded-2xl bg-white border border-neutral-200">CRM Boru Hatları & Pipeline</div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 8. PRICING & MEMBERSHIP (Designjoy style)                                 -->
  <!-- ========================================================================= -->
  <section id="pricing" class="border-b border-neutral-200 bg-white px-6 sm:px-12 py-20 sm:py-32">
    <div class="max-w-4xl mb-16 text-center mx-auto">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 tracking-tight leading-[1.1]">
        One subscription, <span class="text-dj-italics text-neutral-700">endless possibilities</span>
      </h2>
      <p class="text-neutral-500 text-sm mt-3 font-semibold">Pause or cancel anytime.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-6xl mx-auto items-stretch">
      
      <!-- Plan 1 -->
      <div class="rounded-3xl border border-neutral-200 bg-[#fafafa] p-8 sm:p-10 flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono font-bold text-neutral-500 uppercase block mb-1">GHL KURULUMU</span>
          <h3 class="text-2xl font-extrabold text-neutral-900 mb-2">Standart Paket</h3>
          <p class="text-xs text-neutral-600 leading-relaxed mb-6">
            GoHighLevel'a geçmek ve satış hunilerini anahtar teslim otomatize etmek isteyenler için.
          </p>

          <div class="mb-6 pb-6 border-b border-neutral-200">
            <span class="text-3xl font-extrabold text-neutral-900">Özel Teklif</span>
            <span class="text-xs text-neutral-500 font-mono"> / kurulum</span>
          </div>

          <ul class="space-y-3 text-xs text-neutral-700 font-medium mb-8">
            <li class="flex items-center gap-2"><span class="font-bold">✓</span> Sub-Account & DNS Konfigürasyonu</li>
            <li class="flex items-center gap-2"><span class="font-bold">✓</span> 1 Adet Yüksek Dönüşümlü Huni</li>
            <li class="flex items-center gap-2"><span class="font-bold">✓</span> Otomatik SMS & Mail Akışları</li>
            <li class="flex items-center gap-2"><span class="font-bold">✓</span> Stripe Ödeme Kurulumu</li>
          </ul>
        </div>

        <a
          href="/contact?plan=standart"
          class="w-full py-3.5 px-6 rounded-full border border-neutral-300 text-neutral-900 font-bold text-xs text-center hover:bg-neutral-100 transition-colors"
        >
          Görüşme Başlat →
        </a>
      </div>

      <!-- Plan 2: FEATURED BLACK CARD -->
      <div class="rounded-3xl border-2 border-black bg-black text-white p-8 sm:p-10 flex flex-col justify-between shadow-xl">
        <div>
          <span class="text-xs font-mono font-bold text-neutral-400 uppercase block mb-1">EN ÇOK TERCİH EDİLEN</span>
          <h3 class="text-2xl font-extrabold text-white mb-2">Büyüme & AI Ajanı</h3>
          <p class="text-xs text-neutral-400 leading-relaxed mb-6">
            Maksimum dönüşüm isteyen, 7/24 randevu kapatan yapay zekâ asistanıyla büyümek isteyenler için.
          </p>

          <div class="mb-6 pb-6 border-b border-neutral-800">
            <span class="text-3xl font-extrabold text-white">Özel Kapsam</span>
            <span class="text-xs text-neutral-400 font-mono"> / tam sistem</span>
          </div>

          <ul class="space-y-3 text-xs text-neutral-200 font-medium mb-8">
            <li class="flex items-center gap-2"><span class="font-bold text-white">✓</span> Standart Kurulumun Tüm Özellikleri</li>
            <li class="flex items-center gap-2"><span class="font-bold text-white">✓</span> 7/24 AI Randevu & Satış Temsilcisi</li>
            <li class="flex items-center gap-2"><span class="font-bold text-white">✓</span> Çoklu Satış Hunisi & A/B Testleri</li>
            <li class="flex items-center gap-2"><span class="font-bold text-white">✓</span> Özel Make & Webhook Köprüleri</li>
            <li class="flex items-center gap-2"><span class="font-bold text-white">✓</span> 30 Gün Öncelikli Teknik Destek</li>
          </ul>
        </div>

        <a
          href="/contact?plan=ai-growth"
          class="w-full py-4 px-6 rounded-full bg-white text-black font-extrabold text-xs text-center hover:bg-neutral-100 transition-colors"
        >
          Hemen Başlayalım →
        </a>
      </div>

      <!-- Plan 3: 15-min call / Audit -->
      <div class="rounded-3xl border border-neutral-200 bg-[#fafafa] p-8 sm:p-10 flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono font-bold text-neutral-500 uppercase block mb-1">DENETİM & GÖRÜŞME</span>
          <h3 class="text-2xl font-extrabold text-neutral-900 mb-2">Sistem Denetimi</h3>
          <p class="text-xs text-neutral-600 leading-relaxed mb-6">
            Mevcut CRM ve otomasyonlarınızdaki kaçakları ve dönüşüm darboğazlarını analiz etmek için.
          </p>

          <div class="mb-6 pb-6 border-b border-neutral-200">
            <span class="text-3xl font-extrabold text-neutral-900">1-on-1 Seans</span>
            <span class="text-xs text-neutral-500 font-mono"> / 60 dakika</span>
          </div>

          <ul class="space-y-3 text-xs text-neutral-700 font-medium mb-8">
