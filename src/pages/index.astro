---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const featuredServices = services.sort((a, b) => a.data.order - b.data.order);

const projects = await getCollection('projects');
const featuredProjects = projects.filter((p) => p.data.featured).slice(0, 3);

const writings = await getCollection('writing');
const latestWritings = writings
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const research = await getCollection('research');
const researchHighlights = research.slice(0, 2);
---

<Layout
  title="Ercan | GoHighLevel Otomasyonları, Özel Yazılım & AI Sistemleri"
  description="İşletmeler için uçtan uca GHL kurulumları, kurumsal otomasyonlar, özel AI çözümleri ve akademik araştırmalar."
>
  <!-- Hero Section: Business & Technical Authority -->
  <section class="border-b border-zinc-200/80 bg-gradient-to-b from-zinc-50/60 to-white py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <!-- Status badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-xs font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Yeni GHL Kurulumları ve Özel Projeler İçin Müsait</span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-950 leading-[1.15]">
          İşletmeler İçin Ölçeklenebilir <span class="text-amber-600 underline decoration-amber-300 underline-offset-8">GHL Sistemleri</span> ve Akıllı Yazılım Mimarileri.
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-zinc-600 leading-relaxed font-normal">
          Satış ve pazarlama operasyonlarınızı tek bir merkezde toplayan <strong class="text-zinc-900 font-semibold">GoHighLevel (GHL)</strong> otomasyonları kuruyor; yapay zekâ entegrasyonları ve akademik derinlikle desteklenen özel yazılım çözümleri üretiyorum.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/services"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-zinc-950 text-white font-medium text-sm hover:bg-zinc-800 shadow-sm hover:shadow transition-all"
          >
            <span>Hizmetleri & GHL Paketlerini İncele</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-zinc-300 bg-white text-zinc-800 font-medium text-sm hover:bg-zinc-50 transition-colors"
          >
            <span>Doğrudan İletişime Geç</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Business & GHL Solutions (Primary Focus) -->
  <section class="py-16 sm:py-20 border-b border-zinc-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-600 font-mono">
            Hizmetler & İş Kurulumları
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 mt-1">
            İşletmeniz İçin Neler İnşa Ediyorum?
          </h2>
          <p class="text-sm text-zinc-600 mt-2 max-w-xl">
            Manuel iş yükünü ortadan kaldıran, potansiyel müşteriyi satışa dönüştüren anahtar teslim sistemler.
          </p>
        </div>
        <a
          href="/services"
          class="text-sm font-semibold text-zinc-900 hover:text-amber-600 flex items-center gap-1 transition-colors group"
        >
          <span>Tüm Çözümleri Gör</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredServices.map((service) => (
          <div class="rounded-xl border border-zinc-200/90 bg-white p-7 sm:p-8 hover:border-zinc-400 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded text-xs font-medium font-mono bg-zinc-100 text-zinc-800 border border-zinc-200">
                  {service.data.category}
                </span>
                <span class="text-xs text-zinc-400 font-mono">Çözüm #{service.data.order}</span>
              </div>
              <h3 class="text-xl font-bold text-zinc-950 tracking-tight mb-2">
                {service.data.title}
              </h3>
              <p class="text-sm text-zinc-600 leading-relaxed mb-6">
                {service.data.tagline}
              </p>

              <!-- Deliverables checklist -->
              <div class="space-y-2 mb-6">
                <div class="text-xs font-semibold text-zinc-900 uppercase tracking-wider font-mono">
                  Temel Çıktılar:
                </div>
                {service.data.deliverables.slice(0, 3).map((item) => (
                  <div class="flex items-start gap-2 text-xs text-zinc-600">
                    <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-zinc-100 flex items-center justify-between">
              <div class="flex flex-wrap gap-1.5">
                {service.data.techStack.map((tech) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-50 text-zinc-600 border border-zinc-200/60">
                    {tech}
                  </span>
                ))}
              </div>
              <a
                href={`/services#${service.id}`}
                class="text-xs font-semibold text-zinc-900 hover:text-amber-600 transition-colors"
              >
                Detaylar →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Selected Projects & Case Studies -->
  <section class="py-16 sm:py-20 border-b border-zinc-200/80 bg-zinc-50/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-600 font-mono">
            Vaka Analizleri & Portföy
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 mt-1">
            Özel Projeler & Uygulamalar
          </h2>
          <p class="text-sm text-zinc-600 mt-2 max-w-xl">
            Gerçek işletmeler ve karmaşık veri problemleri için geliştirilen mimariler.
          </p>
        </div>
        <a
          href="/projects"
          class="text-sm font-semibold text-zinc-900 hover:text-amber-600 flex items-center gap-1 transition-colors group"
        >
          <span>Tüm Projeler</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredProjects.map((project) => (
          <div class="rounded-xl border border-zinc-200 bg-white p-6 hover:border-zinc-300 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-zinc-500 font-mono mb-3">
                <span>{project.data.category}</span>
                <span>{project.data.year}</span>
              </div>
              <h3 class="text-lg font-bold text-zinc-950 mb-2">
                {project.data.title}
              </h3>
              <p class="text-sm text-zinc-600 leading-relaxed mb-4">
                {project.data.description}
              </p>
            </div>
            <div class="flex flex-wrap gap-1.5 pt-4 border-t border-zinc-100">
              {project.data.tech.map((t) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-100 text-zinc-700">
                  {t}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Latest Writings (Magazine Editorial Style like Sebastian Raschka) -->
  <section class="py-16 sm:py-20 border-b border-zinc-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-600 font-mono">
            Editoryal Dergi & Teknik Yazılar
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 mt-1">
            Yazılar & Analizler
          </h2>
          <p class="text-sm text-zinc-600 mt-2 max-w-xl">
            Yapay zekâ mimarileri, sistem tasarımı ve derin teknik incelemeler.
          </p>
        </div>
        <a
          href="/writing"
          class="text-sm font-semibold text-zinc-900 hover:text-amber-600 flex items-center gap-1 transition-colors group"
        >
          <span>Tüm Yazılar ({writings.length})</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="space-y-6">
        {latestWritings.map((post) => (
          <article class="group rounded-xl border border-zinc-200 bg-white p-6 sm:p-7 hover:border-zinc-400 hover:shadow-sm transition-all">
            <a href={`/writing/${post.id}`} class="block">
              <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-500 font-mono mb-2">
                <span class="text-amber-600 font-medium">{post.data.category}</span>
                <span>•</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span>•</span>
                <span>{post.data.readingTime}</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-zinc-950 group-hover:text-amber-600 transition-colors tracking-tight">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm sm:text-base text-zinc-600 leading-relaxed font-editorial">
                {post.data.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-100 text-zinc-600">
                    #{tag}
                  </span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Academic & Research Highlights -->
  <section class="py-16 sm:py-20 bg-zinc-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-600 font-mono">
            Akademik Çalışmalar & AI
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 mt-1">
            Araştırma Alanları & Makaleler
          </h2>
        </div>
        <a
          href="/research"
          class="text-sm font-semibold text-zinc-900 hover:text-amber-600 flex items-center gap-1 transition-colors"
        >
          <span>Araştırma Sayfasına Git</span> →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {researchHighlights.map((item) => (
          <div class="rounded-xl border border-zinc-200 bg-white p-6">
            <div class="flex items-center justify-between text-xs font-mono text-zinc-500 mb-2">
              <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 font-medium">
                {item.data.status}
              </span>
              <span>{item.data.year}</span>
            </div>
            <h3 class="text-base font-bold text-zinc-950 mt-2 mb-2">
              {item.data.title}
            </h3>
            <p class="text-xs text-zinc-600 leading-relaxed">
              {item.data.abstract}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
