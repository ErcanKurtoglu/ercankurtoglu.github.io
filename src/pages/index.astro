---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects.slice(0, 3);

const writings = await getCollection('writing');
const latestWritings = writings.slice(0, 2);

const research = await getCollection('research');
---

<Layout
  title="Ercan Kurtoğlu | GoHighLevel & AI Subscriptions"
  description="GoHighLevel iş sistemleri kurulumu, satış hunileri ve yapay zekâ abonelikleri. Pause or cancel anytime."
>
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION: Responsive Designjoy 2-Column Split                      -->
  <!-- ========================================================================= -->
  <section class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#121212] px-4 sm:px-8 lg:px-12 py-12 sm:py-20 lg:py-24 transition-colors duration-200">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center max-w-full">
      
      <!-- Hero Left -->
      <div class="lg:col-span-7 space-y-5 sm:space-y-6">
        <!-- Available status badge -->
        <div class="inline-flex items-center gap-2 px-3 sm:px-3.5 py-1.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-[11px] sm:text-xs font-bold text-neutral-800 dark:text-neutral-200 transition-colors max-w-full">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
          <span data-i18n="hero.badge" class="truncate">Kasım ayı için yeni kurulum: <strong>2 Müsait</strong></span>
        </div>

        <h1 data-i18n="hero.title" class="text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-neutral-900 dark:text-white tracking-tight leading-[1.08] break-words">
          İşletmeler için GoHighLevel & AI <span class="text-dj-italics text-neutral-700 dark:text-neutral-300">abonelikleri</span>
        </h1>

        <p data-i18n="hero.subtitle" class="text-neutral-600 dark:text-neutral-400 text-base sm:text-lg lg:text-xl font-medium pt-1 sm:pt-2">
          Pause or cancel anytime. <span class="text-neutral-400 dark:text-neutral-500 font-normal">Hantal ajans süreçleri yok.</span>
        </p>

        <!-- Buttons -->
        <div class="pt-3 sm:pt-4 flex flex-col xs:flex-row items-stretch xs:items-center gap-3">
          <a
            href="#pricing"
            class="px-6 sm:px-8 py-3.5 sm:py-4 rounded-full bg-black dark:bg-white text-white dark:text-black font-bold text-xs sm:text-sm hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all shadow-md text-center"
          >
            <span data-i18n="hero.seePricing">Fiyatları İncele</span>
          </a>
          <a
            href="/contact"
            class="px-6 sm:px-8 py-3.5 sm:py-4 rounded-full bg-white dark:bg-[#1c1c1c] border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 font-bold text-xs sm:text-sm hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors shadow-sm text-center"
          >
            <span data-i18n="hero.bookCall">Görüşme Planla</span>
          </a>
        </div>
      </div>

      <!-- Hero Right: The Designjoy Member Card Mockup -->
      <div class="lg:col-span-5 w-full">
        <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#f9fafb] dark:bg-[#181818] p-5 sm:p-8 lg:p-10 shadow-sm relative overflow-hidden space-y-6 sm:space-y-8 transition-colors">
          
          <div class="space-y-1.5 sm:space-y-2">
            <span data-i18n="hero.cardTag" class="text-[10px] sm:text-[11px] font-mono uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-bold block">
              SYSTEM ARCHITECTURE
            </span>
            <div data-i18n="hero.cardName" class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-neutral-900 dark:text-white leading-none">
              Ercan Kurtoğlu
            </div>
            <p data-i18n="hero.cardTagline" class="text-xs text-neutral-500 dark:text-neutral-400 font-medium pt-0.5">
              Tüm operasyonu otomatize eden tek abonelik.
            </p>
          </div>

          <div class="p-4 sm:p-6 rounded-xl sm:rounded-2xl bg-white dark:bg-[#202020] border border-neutral-200 dark:border-neutral-700/60 shadow-sm space-y-3 sm:space-y-4 transition-colors">
            <div class="flex items-center justify-between text-xs font-bold text-neutral-900 dark:text-white border-b border-neutral-100 dark:border-neutral-700/50 pb-2.5 sm:pb-3">
              <span data-i18n="hero.cardStatusTitle">Kurulum & Otomasyon</span>
              <span data-i18n="hero.cardStatusActive" class="text-emerald-600 dark:text-emerald-400 font-mono">Aktif</span>
            </div>
            <ul class="space-y-2 text-xs text-neutral-600 dark:text-neutral-300">
              <li class="flex items-center gap-2">
                <span class="text-black dark:text-white font-bold shrink-0">✓</span>
                <span data-i18n="hero.cardItem1">Uçtan Uca GoHighLevel CRM</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-black dark:text-white font-bold shrink-0">✓</span>
                <span data-i18n="hero.cardItem2">7/24 AI Randevu Asistanı</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-black dark:text-white font-bold shrink-0">✓</span>
                <span data-i18n="hero.cardItem3">Özel Make & Zapier Köprüleri</span>
              </li>
            </ul>
          </div>

          <!-- Bottom Schedule Bar -->
          <a
            href="/contact"
            class="flex items-center justify-between p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-white dark:bg-[#202020] border border-neutral-200 dark:border-neutral-700/60 hover:border-neutral-400 dark:hover:border-neutral-500 hover:shadow-md transition-all text-xs font-bold text-neutral-900 dark:text-white"
          >
            <div class="flex items-center gap-2.5 sm:gap-3">
              <div class="w-8 h-8 rounded-full bg-black dark:bg-white text-white dark:text-black flex items-center justify-center text-xs shrink-0">
                📞
              </div>
              <div class="text-left">
                <div data-i18n="hero.cardCallTitle" class="leading-tight">15-dakikalık tanışma seansı</div>
                <div data-i18n="hero.cardCallSub" class="text-[11px] text-neutral-400 dark:text-neutral-500 font-normal">Hemen takvimden seçin</div>
              </div>
            </div>
            <span class="text-neutral-400 dark:text-neutral-500 shrink-0">→</span>
          </a>

        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. "THE WAY SYSTEMS SHOULD'VE BEEN DONE" (3 Step Cards)                   -->
  <!-- ========================================================================= -->
  <section id="how-it-works" class="border-b border-neutral-200 dark:border-neutral-800 bg-[#fbfbfb] dark:bg-[#161616] px-4 sm:px-8 lg:px-12 py-16 sm:py-24 lg:py-28 transition-colors duration-200">
    <div class="max-w-4xl mb-12 sm:mb-16">
      <h2 data-i18n="steps.heading" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight leading-[1.15]">
        Sistemlerin en başından beri <span class="text-dj-italics text-neutral-700 dark:text-neutral-300">olması gerektiği</span> gibi
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      <!-- Card 1 -->
      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 lg:p-10 hover:shadow-md transition-all">
        <div data-i18n="steps.s1Title" class="text-xl sm:text-2xl font-extrabold text-neutral-900 dark:text-white mb-2">Abone Olun</div>
        <p data-i18n="steps.s1Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Bir plana abone olun veya tek seferlik kurulum paketinizi seçin. Sürpriz ek maliyet olmadan hemen başlayalım.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 lg:p-10 hover:shadow-md transition-all">
        <div data-i18n="steps.s2Title" class="text-xl sm:text-2xl font-extrabold text-neutral-900 dark:text-white mb-2">Talep Edin</div>
        <p data-i18n="steps.s2Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Satış hunisi, SMS iş akışı, AI randevu botu veya ödeme entegrasyonu... İhtiyacınız olan her sistemi talep edin.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 lg:p-10 hover:shadow-md transition-all">
        <div data-i18n="steps.s3Title" class="text-xl sm:text-2xl font-extrabold text-neutral-900 dark:text-white mb-2">Teslim Alın</div>
        <p data-i18n="steps.s3Desc" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Sistemleriniz canlı testleriyle birlikte birkaç iş günü içinde doğrudan hesabınıza teslim edilir.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. INFINITE LOGO MARQUEE                                                  -->
  <!-- ========================================================================= -->
  <section class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#121212] py-5 sm:py-6 overflow-hidden transition-colors duration-200 w-full">
    <div class="marquee-mask flex overflow-x-hidden relative w-full">
      <div class="animate-marquee flex items-center gap-10 sm:gap-14 whitespace-nowrap text-neutral-600 dark:text-neutral-400 font-extrabold text-xs sm:text-sm font-sans">
        <span>GoHighLevel (GHL)</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>OpenAI API</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Make.com</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Stripe</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Twilio</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Claude 3.5</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Python & FastAPI</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>WhatsApp Business</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <!-- Loop -->
        <span>GoHighLevel (GHL)</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>OpenAI API</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Make.com</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Stripe</span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span>Twilio</span>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. RECENT WORK SHOWCASE (Designjoy style)                                  -->
  <!-- ========================================================================= -->
  <section id="work" class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#121212] px-4 sm:px-8 lg:px-12 py-16 sm:py-24 lg:py-28 transition-colors duration-200">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 sm:mb-14 gap-3 sm:gap-4">
      <div>
        <h2 data-i18n="work.heading" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
          Öne Çıkan Çalışmalar
        </h2>
        <p data-i18n="work.sub" class="text-neutral-500 dark:text-neutral-400 text-xs sm:text-sm mt-1 sm:mt-2 font-medium">Uygulanan sistemler ve somut iş çıktıları.</p>
      </div>
      <a href="/projects" data-i18n="work.all" class="text-xs font-bold text-black dark:text-white underline underline-offset-4 hover:text-neutral-700 dark:hover:text-neutral-300">
        Tüm projeler →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {featuredProjects.map((p) => (
        <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#f9fafb] dark:bg-[#181818] p-6 sm:p-8 hover:border-neutral-400 dark:hover:border-neutral-600 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-3">
              <span class="font-bold text-black dark:text-white">{p.data.category}</span>
              <span>{p.data.year}</span>
            </div>
            <h3 class="text-lg sm:text-xl font-extrabold text-neutral-900 dark:text-white mb-2 leading-snug">
              {p.data.title}
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
              {p.data.description}
            </p>
          </div>
          <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
            <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400">{p.data.tech.slice(0, 2).join(', ')}</span>
            <a href="/projects" data-i18n="work.inspect" class="text-xs font-bold text-black dark:text-white hover:underline">İncele →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. "IT'S 'YOU'LL NEVER GO BACK' BETTER" (Membership Perks 6'lı Grid)       -->
  <!-- ========================================================================= -->
  <section id="benefits" class="border-b border-neutral-200 dark:border-neutral-800 bg-[#fbfbfb] dark:bg-[#161616] px-4 sm:px-8 lg:px-12 py-16 sm:py-24 lg:py-32 transition-colors duration-200">
    <div class="max-w-4xl mb-12 sm:mb-16">
      <h2 data-i18n="perks.heading" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight leading-[1.15]">
        Bir kez deneyince <span class="text-dj-italics text-neutral-700 dark:text-neutral-300">"asla geri dönmeyeceğiniz"</span> kalitede
      </h2>
      <p data-i18n="perks.sub" class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base mt-3 sm:mt-4 max-w-xl">
        Karmaşık ajans toplantılarını ve saatlik faturaları geride bırakın.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">⚡️</div>
        <h3 data-i18n="perks.p1Title" class="text-base sm:text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Işık Hızında Teslimat</h3>
        <p data-i18n="perks.p1Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Haftalarca beklemek yok. Hunileriniz ve iş akışlarınız ortalama birkaç iş günü içinde hazır.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">💳</div>
        <h3 data-i18n="perks.p2Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Sabit Paket Ücreti</h3>
        <p data-i18n="perks.p2Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Sürpriz fatura yok. Ne alacağınızı ve ne ödeyeceğinizi baştan bilirsiniz.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">💎</div>
        <h3 data-i18n="perks.p3Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Üst Düzey Kod & Mimari</h3>
        <p data-i18n="perks.p3Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Rastgele şablonlar değil; akademik AI araştırmaları ve kurumsal yazılım disipliniyle inşa edilmiş altyapı.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">🤝</div>
        <h3 data-i18n="perks.p4Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Birebir Kurucu İletişimi</h3>
        <p data-i18n="perks.p4Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Aracı hesap yöneticileri yok. Doğrudan sistemi tasarlayan ve kodu yazan kişiyle konuşursunuz.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">🔒</div>
        <h3 data-i18n="perks.p5Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">%100 Sizin Mülkiyetinizde</h3>
        <p data-i18n="perks.p5Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Tüm GoHighLevel hesabı, müşteri verileri ve şablonlar doğrudan sizin şirketinize aittir.
        </p>
      </div>

      <div class="rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#1a1a1a] p-6 sm:p-8 hover:shadow-md transition-all">
        <div class="text-2xl mb-3 sm:mb-4">🎓</div>
        <h3 data-i18n="perks.p6Title" class="text-lg font-extrabold text-neutral-900 dark:text-white mb-2">Eğitim & 30 Gün Destek</h3>
        <p data-i18n="perks.p6Desc" class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Teslimat sonrası ekibinize özel video dokümantasyonu ve 30 gün öncelikli teknik destek.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 6. "IT'S REALLY JUST ME" (FOUNDER BIO BÖLÜMÜ - Designjoy Brett Card)       -->
  <!-- ========================================================================= -->
  <section id="about" class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#121212] px-4 sm:px-8 lg:px-12 py-16 sm:py-24 lg:py-32 transition-colors duration-200">
    <div class="max-w-5xl mx-auto">
      
      <div class="mb-10 sm:mb-14">
        <h2 data-i18n="about.heading" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight leading-[1.15]">
          Gerçekten <span class="text-dj-italics text-neutral-700 dark:text-neutral-300">sadece benim</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center rounded-2xl sm:rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#f9fafb] dark:bg-[#181818] p-6 sm:p-8 lg:p-12 transition-colors">
        
        <!-- Left: Founder Card with Live Interactive Logo Switcher -->
        <div class="lg:col-span-5 text-center flex flex-col items-center space-y-4 max-w-sm mx-auto lg:max-w-none w-full">
          <div class="w-full flex flex-col items-center">
            <div id="founder-logo-display" class="relative">
              <div data-founder-logo-variant="slide2-boxed" class="founder-logo-slot block">
                <Logo variant="slide2-boxed" className="w-24 h-24 sm:w-32 sm:h-32 !rounded-2xl sm:!rounded-3xl shadow-xl p-3" size={110} />
              </div>
              <div data-founder-logo-variant="slide2-pure" class="founder-logo-slot hidden">
                <Logo variant="slide2-pure" className="w-24 h-24 sm:w-32 sm:h-32 !rounded-2xl sm:!rounded-3xl shadow-xl p-3 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800" size={110} />
              </div>
              <div data-founder-logo-variant="slide2-inverted" class="founder-logo-slot hidden">
                <Logo variant="slide2-inverted" className="w-24 h-24 sm:w-32 sm:h-32 !rounded-2xl sm:!rounded-3xl shadow-xl p-3" size={110} />
              </div>
              <div data-founder-logo-variant="badge" class="founder-logo-slot hidden">
                <Logo variant="badge" className="w-24 h-24 sm:w-32 sm:h-32 !rounded-2xl sm:!rounded-3xl shadow-xl" size={110} />
              </div>
            </div>

            <!-- Live Logo Comparison Switcher Buttons -->
            <div class="mt-3.5 flex flex-wrap items-center justify-center gap-1 p-1 bg-neutral-200/80 dark:bg-neutral-900 rounded-xl border border-neutral-300 dark:border-neutral-800 text-[10px] sm:text-[11px] font-bold">
              <button
                type="button"
                class="logo-pick-btn px-2.5 py-1 rounded-lg bg-white dark:bg-neutral-800 text-black dark:text-white shadow-xs cursor-pointer transition-all"
                data-logo-target="slide2-boxed"
              >
                Slide 2 (Kutu)
              </button>
              <button
                type="button"
                class="logo-pick-btn px-2.5 py-1 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white cursor-pointer transition-all"
                data-logo-target="slide2-pure"
              >
                Slide 2 (Saf Glif)
              </button>
              <button
                type="button"
                class="logo-pick-btn px-2.5 py-1 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white cursor-pointer transition-all"
                data-logo-target="slide2-inverted"
              >
                Slide 2 (Rozet)
              </button>
              <button
                type="button"
                class="logo-pick-btn px-2.5 py-1 rounded-lg text-neutral-500 hover:text-black dark:hover:text-white cursor-pointer transition-all"
                data-logo-target="badge"
              >
                Geometrik E-K
              </button>
            </div>
            <p class="text-[10px] text-neutral-400 dark:text-neutral-500 font-mono mt-1">Canlı test: Tıklayarak sitede anında değiştirin</p>
          </div>
          <div>
            <h3 class="text-xl sm:text-2xl font-extrabold text-neutral-900 dark:text-white">Ercan Kurtoğlu</h3>
