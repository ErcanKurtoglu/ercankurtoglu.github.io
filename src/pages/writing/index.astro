---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const writings = await getCollection('writing');
const sortedWritings = writings.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const allTags = [...new Set(writings.flatMap((w) => w.data.tags))];
---

<Layout
  title="Teknik Yazılar & AI Analizleri | Ercan Kurtoğlu"
  description="Yapay zekâ mimarileri, sistem mühendisliği, GHL otomasyon stratejileri ve derin teknik analizler."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Header -->
    <header class="border-b border-white/10 pb-12 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-mono font-medium mb-4">
        // TEKNİK BÜLTEN & DERGİ
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-heading">
        Yazılar & Teknik Analizler
      </h1>
      <p class="mt-4 text-base sm:text-lg text-zinc-400 max-w-2xl leading-relaxed">
        Yapay zekânın teorik temelleri, kurumsal sistemlerde karşılaşılan darboğazlar ve gerçek dünya mühendislik pratikleri üzerine derinlemesine incelemeler.
      </p>

      <!-- Tags bar -->
      {allTags.length > 0 && (
        <div class="mt-8 flex flex-wrap items-center gap-2">
          <span class="text-xs text-zinc-400 font-mono">Etiketler:</span>
          {allTags.map((tag) => (
            <span class="px-3 py-1 rounded-lg text-xs font-mono bg-white/5 border border-white/10 text-zinc-300">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Articles List -->
    <div class="space-y-8">
      {sortedWritings.map((post) => (
        <article class="group rounded-3xl border border-white/10 bg-white/[0.02] p-8 sm:p-10 hover:border-white/25 hover:bg-white/[0.04] transition-all">
          <a href={`/writing/${post.id}`} class="block">
            <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-400 font-mono mb-4">
              <span class="px-2.5 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30 font-medium">
                {post.data.category}
              </span>
              <span>•</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span>•</span>
              <span>{post.data.readingTime}</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-white group-hover:text-amber-400 transition-colors tracking-tight font-heading">
              {post.data.title}
            </h2>

            <p class="mt-3 text-sm sm:text-base text-zinc-400 leading-relaxed font-editorial">
              {post.data.description}
            </p>

            <div class="mt-6 flex items-center justify-between pt-6 border-t border-white/10">
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-xs font-mono text-zinc-400">
                    #{tag}
                  </span>
                ))}
              </div>
              <span class="text-xs font-semibold text-white group-hover:text-amber-400 flex items-center gap-1.5 transition-colors">
                Yazıyı Oku →
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
