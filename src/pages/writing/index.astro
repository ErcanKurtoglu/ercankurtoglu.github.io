---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const writings = await getCollection('writing');
const sortedWritings = writings.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const allTags = [...new Set(writings.flatMap((w) => w.data.tags))];
---

<Layout
  title="Yazılar & Teknik Analizler | Ercan"
  description="Yapay zekâ mimarileri, sistem mühendisliği, GHL otomasyon stratejileri ve derin teknik analizler."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <!-- Header -->
    <header class="border-b border-zinc-200 pb-10 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200/80 text-amber-800 text-xs font-mono font-medium mb-4">
        TEKNİK BÜLTEN & DERGİ
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-950">
        Yazılar & Teknik Analizler
      </h1>
      <p class="mt-4 text-base sm:text-lg text-zinc-600 max-w-2xl font-editorial">
        Yapay zekânın teorik temelleri, kurumsal mimarilerde karşılaşılan zorluklar ve gerçek dünya sistemleri üzerine editoryal incelemeler.
      </p>

      <!-- Tags bar -->
      {allTags.length > 0 && (
        <div class="mt-8 flex flex-wrap items-center gap-2">
          <span class="text-xs text-zinc-400 font-mono">Etiketler:</span>
          {allTags.map((tag) => (
            <span class="px-2.5 py-1 rounded text-xs font-mono bg-zinc-100 text-zinc-700 hover:bg-zinc-200 transition-colors">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Articles List -->
    <div class="space-y-8">
      {sortedWritings.map((post) => (
        <article class="group rounded-xl border border-zinc-200/90 bg-white p-7 sm:p-8 hover:border-zinc-400 hover:shadow-sm transition-all">
          <a href={`/writing/${post.id}`} class="block">
            <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-500 font-mono mb-3">
              <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-800 font-medium">
                {post.data.category}
              </span>
              <span>•</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span>•</span>
              <span>{post.data.readingTime}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 group-hover:text-amber-600 transition-colors tracking-tight">
              {post.data.title}
            </h2>

            <p class="mt-3 text-sm sm:text-base text-zinc-600 leading-relaxed font-editorial">
              {post.data.description}
            </p>

            <div class="mt-5 flex items-center justify-between pt-4 border-t border-zinc-100">
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-xs font-mono text-zinc-500">
                    #{tag}
                  </span>
                ))}
              </div>
              <span class="text-xs font-semibold text-zinc-900 group-hover:text-amber-600 flex items-center gap-1 transition-colors">
                Yazıyı Oku →
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
