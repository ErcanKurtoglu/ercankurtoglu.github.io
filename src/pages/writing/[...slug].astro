---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const writings = await getCollection('writing');
  return writings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Layout
  title={`${entry.data.title} | Ercan`}
  description={entry.data.description}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-16 left-0 h-1 bg-amber-500 z-50 transition-all duration-75 w-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Back button & Issue meta -->
    <div class="mb-8">
      <a
        href="/writing"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-500 hover:text-zinc-950 font-mono transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Tüm Yazılara Dön</span>
      </a>
    </div>

    <!-- Article Header: Sebastian Raschka Editorial Style -->
    <header class="max-w-3xl border-b border-zinc-200 pb-8 mb-12">
      <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-500 font-mono mb-4">
        <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 font-semibold">
          {entry.data.category}
        </span>
        <span>•</span>
        <time datetime={entry.data.pubDate.toISOString()}>
          {entry.data.pubDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>•</span>
        <span>{entry.data.readingTime}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-950 leading-[1.15]">
        {entry.data.title}
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-zinc-600 leading-relaxed font-editorial italic">
        {entry.data.description}
      </p>

      <!-- Author snippet -->
      <div class="mt-6 pt-6 border-t border-zinc-100 flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-zinc-900 text-white font-bold text-sm flex items-center justify-center">
          E
        </div>
        <div>
          <div class="text-xs font-semibold text-zinc-900">Ercan</div>
          <div class="text-[11px] text-zinc-500">Business Systems, GHL & AI Researcher</div>
        </div>
      </div>
    </header>

    <!-- Main Content Layout with 2 Columns: Article + Sticky Table of Contents -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Article Content (8 cols on large screens) -->
      <article class="lg:col-span-8 prose prose-zinc prose-base sm:prose-lg max-w-none 
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-zinc-950
        prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-zinc-200
        prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-zinc-700 prose-p:leading-relaxed
        prose-pre:rounded-xl prose-pre:border prose-pre:border-zinc-800 prose-pre:shadow-sm
        prose-code:text-amber-800 prose-code:bg-amber-50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
        prose-blockquote:border-l-amber-500 prose-blockquote:bg-amber-50/40 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-blockquote:not-italic
        prose-ul:text-zinc-700 prose-li:my-1">
        <Content />
      </article>

      <!-- Sticky Context / Table of Contents (4 cols on large screens) -->
      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-24 space-y-6">
          <div class="p-5 rounded-xl border border-zinc-200/90 bg-zinc-50/60">
            <TableOfContents headings={headings} />
          </div>

          <!-- Quick Action CTA -->
          <div class="p-5 rounded-xl border border-amber-200 bg-amber-50/50 space-y-3">
            <div class="text-xs font-semibold uppercase tracking-wider text-amber-900 font-mono">
              Fikir & Danışmanlık
            </div>
            <p class="text-xs text-amber-900/80 leading-relaxed">
              Bu konuda bir proje mi hayata geçirmek istiyorsunuz veya işletmeniz için GHL otomasyonu mu arıyorsunuz?
            </p>
            <a
              href="/contact"
              class="inline-flex items-center justify-center w-full px-4 py-2 rounded-lg bg-zinc-950 text-white font-medium text-xs hover:bg-zinc-800 transition-colors"
            >
              Doğrudan E-posta Gönder
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Article Footer / Author Box -->
    <div class="max-w-3xl mt-16 pt-8 border-t border-zinc-200">
      <div class="rounded-xl border border-zinc-200 p-6 bg-zinc-50 flex flex-col sm:flex-row items-start gap-4">
        <div class="w-12 h-12 rounded-full bg-zinc-900 text-white font-bold text-lg flex items-center justify-center flex-shrink-0">
          E
        </div>
        <div class="space-y-2">
          <h4 class="text-sm font-bold text-zinc-950">Yazar Hakkında: Ercan</h4>
          <p class="text-xs text-zinc-600 leading-relaxed">
            GoHighLevel mimarisi, uçtan uca satış otomasyonları ve kurumsal yapay zekâ entegrasyonları üzerine danışmanlık vermekte; aynı zamanda dil modellerinde muhakeme sistemleri üzerine akademik araştırmalarını sürdürmektedir.
          </p>
          <div class="pt-2 flex items-center gap-4 text-xs font-semibold text-zinc-900">
            <a href="/services" class="hover:text-amber-600 transition-colors">GHL Çözümleri →</a>
            <a href="/contact" class="hover:text-amber-600 transition-colors">İletişime Geç →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Reading progress tracker
  const progressBar = document.getElementById('reading-progress');
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = (window.scrollY / totalHeight) * 100;
    if (progressBar) {
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }
  });
</script>
