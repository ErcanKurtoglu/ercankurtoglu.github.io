---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const writings = await getCollection('writing');
  return writings.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Layout
  title={`${entry.data.title} | Ercan Kurtoğlu`}
  description={entry.data.description}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-20 left-0 h-1 bg-amber-400 z-50 transition-all duration-75 w-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <!-- Back button -->
    <div class="mb-8">
      <a
        href="/writing"
        class="inline-flex items-center gap-2 text-xs font-semibold text-zinc-400 hover:text-white font-mono transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Tüm Yazılara Dön</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="max-w-3xl border-b border-white/10 pb-10 mb-12">
      <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-400 font-mono mb-4">
        <span class="px-2.5 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30 font-semibold">
          {entry.data.category}
        </span>
        <span>•</span>
        <time datetime={entry.data.pubDate.toISOString()}>
          {entry.data.pubDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>•</span>
        <span>{entry.data.readingTime}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-[1.12] font-heading">
        {entry.data.title}
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-zinc-400 leading-relaxed font-editorial italic">
        {entry.data.description}
      </p>

      <!-- Author snippet -->
      <div class="mt-8 pt-6 border-t border-white/10 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-amber-500 text-black font-bold text-sm flex items-center justify-center">
          EK
        </div>
        <div>
          <div class="text-xs font-bold text-white">Ercan Kurtoğlu</div>
          <div class="text-[11px] text-zinc-400">GHL & AI Systems Architect</div>
        </div>
      </div>
    </header>

    <!-- Main Content Layout with 2 Columns: Article + Sticky Table of Contents -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Article Content (8 cols) -->
      <article class="lg:col-span-8 prose prose-invert prose-zinc prose-base sm:prose-lg max-w-none 
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white prose-headings:font-heading
        prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-3 prose-h2:border-b prose-h2:border-white/10
        prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-zinc-300 prose-p:leading-relaxed
        prose-pre:rounded-2xl prose-pre:border prose-pre:border-white/10 prose-pre:bg-black/60
        prose-code:text-amber-300 prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
        prose-blockquote:border-l-amber-500 prose-blockquote:bg-white/[0.02] prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:text-zinc-300
        prose-ul:text-zinc-300 prose-li:my-1.5">
        <Content />
      </article>

      <!-- Sticky Context / Table of Contents (4 cols) -->
      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-28 space-y-6">
          <div class="p-6 rounded-2xl border border-white/10 bg-white/[0.02]">
            <TableOfContents headings={headings} />
          </div>

          <!-- Quick Action CTA -->
          <div class="p-6 rounded-2xl border border-amber-500/20 bg-amber-500/5 space-y-3">
            <div class="text-xs font-bold uppercase tracking-wider text-amber-400 font-mono">
              Fikir & Danışmanlık
            </div>
            <p class="text-xs text-zinc-300 leading-relaxed">
              Bu makaledeki mimariyi işletmenize entegre etmek veya GHL sisteminizi otomatize etmek ister misiniz?
            </p>
            <a
              href="/contact"
              class="inline-flex items-center justify-center w-full px-4 py-2.5 rounded-xl bg-white text-black font-bold text-xs hover:bg-zinc-200 transition-colors"
            >
              Görüşme Başlatın →
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Article Footer / Author Box -->
    <div class="max-w-3xl mt-20 pt-10 border-t border-white/10">
      <div class="rounded-2xl border border-white/10 p-8 bg-white/[0.02] flex flex-col sm:flex-row items-start gap-5">
        <div class="w-14 h-14 rounded-2xl bg-amber-500 text-black font-bold text-xl flex items-center justify-center flex-shrink-0">
          EK
        </div>
        <div class="space-y-3">
          <h4 class="text-base font-bold text-white font-heading">Yazar: Ercan Kurtoğlu</h4>
          <p class="text-xs text-zinc-400 leading-relaxed">
            GoHighLevel mimarisi, satış otomasyonları ve kurumsal yapay zekâ sistemleri üzerine anahtar teslim projeler kurmakta; aynı zamanda büyük dil modellerinde muhakeme mimarileri üzerine araştırmalarını sürdürmektedir.
          </p>
          <div class="pt-2 flex items-center gap-5 text-xs font-semibold">
            <a href="/#pricing" class="text-amber-400 hover:text-amber-300 transition-colors">Paketleri İncele →</a>
            <a href="/contact" class="text-white hover:text-zinc-300 transition-colors">İletişime Geç →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Reading progress tracker
  const progressBar = document.getElementById('reading-progress');
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = (window.scrollY / totalHeight) * 100;
    if (progressBar) {
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }
  });
</script>
