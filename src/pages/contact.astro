---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="İletişim & İş Birliği | Ercan Kurtoğlu"
  description="GoHighLevel iş kurulumları, yapay zekâ danışmanlığı veya akademik iş birlikleri için doğrudan e-posta ile iletişime geçin."
>
  <div class="max-w-4xl mx-auto px-6 sm:px-8 py-16 sm:py-24">
    <header class="border-b border-neutral-200 dark:border-neutral-800 pb-10 mb-12 transition-colors">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 text-xs font-mono font-medium mb-4">
        // İLETİŞİM & GÖRÜŞME
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-white font-sans">
        Sisteminizi Konuşalım
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
        İşletmeniz için GoHighLevel kurulumu, özel AI otomasyonları veya akademik/teknik bir konu hakkında doğrudan bana yazabilirsiniz.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <!-- Direct Email Card -->
      <div class="md:col-span-7 space-y-6">
        <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#f9fafb] dark:bg-[#181818] p-8 transition-colors">
          <div class="flex items-center gap-3.5 mb-6">
            <div class="w-10 h-10 rounded-2xl bg-black dark:bg-white text-white dark:text-black flex items-center justify-center font-bold text-sm">
              ✉️
            </div>
            <div>
              <h2 class="text-base font-bold text-neutral-900 dark:text-white">Doğrudan Kurumsal İletişim</h2>
              <p class="text-xs text-neutral-500 dark:text-neutral-400">Aracı yönetici yok, doğrudan sistem mimarı yanıtlar</p>
            </div>
          </div>

          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
            Gelen tüm mesajları şahsen okuyor ve iş günlerinde <strong>24 saat içinde</strong> dönüş yapıyorum.
          </p>

          <!-- Email Copy & Click Box -->
          <div class="p-4 rounded-2xl bg-white dark:bg-[#202020] border border-neutral-200 dark:border-neutral-700/60 flex flex-col sm:flex-row items-center justify-between gap-4 transition-colors">
            <div class="font-mono text-xs sm:text-sm font-semibold text-neutral-900 dark:text-white select-all break-all text-center sm:text-left" id="email-address">
              iletisim@ercankurtoglu.site
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto shrink-0">
              <button
                type="button"
                id="copy-email-btn"
                class="flex-1 sm:flex-initial px-3.5 py-2 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-xs font-bold text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors cursor-pointer"
              >
                Kopyala
              </button>
              <a
                id="mailto-link"
                href="mailto:iletisim@ercankurtoglu.site?subject=GHL%20ve%20AI%20Sistem%20G%C3%B6r%C3%BC%C5%9Fmesi"
                class="flex-1 sm:flex-initial px-4 py-2 rounded-full bg-black dark:bg-white text-white dark:text-black text-xs font-bold hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors text-center shadow-xs whitespace-nowrap"
              >
                E-posta Gönder →
              </a>
            </div>
          </div>
        </div>

        <!-- Scope Checklist -->
        <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#181818] p-6 space-y-3 transition-colors">
          <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white font-mono">
            Hangi Konularda İletişime Geçebilirsiniz?
          </h3>
          <ul class="space-y-2.5 text-xs text-neutral-600 dark:text-neutral-400">
            <li class="flex items-center gap-2">
              <span class="text-black dark:text-white font-bold">✓</span>
              <span>GoHighLevel (GHL) anahtar teslim iş kurulumları ve huniler</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-black dark:text-white font-bold">✓</span>
              <span>Şirket verinizle eğitilmiş 7/24 AI satış ve randevu ajanları</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-black dark:text-white font-bold">✓</span>
              <span>Mevcut CRM ve otomasyon kaçaklarının denetimi (Audit)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-black dark:text-white font-bold">✓</span>
              <span>Yapay zekâ ve mantıksal çıkarım üzerine akademik iş birlikleri</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Channels & Privacy -->
      <div class="md:col-span-5 space-y-6">
        <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#f9fafb] dark:bg-[#181818] p-6 space-y-4 transition-colors">
          <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white font-mono">
            Sosyal & Profesyonel Kanallar
          </h3>

          <div class="space-y-2">
            <a
              href="https://github.com/ErcanKurtoglu"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3.5 rounded-2xl border border-neutral-200 dark:border-neutral-700/60 bg-white dark:bg-[#202020] hover:border-neutral-400 dark:hover:border-neutral-500 transition-all text-xs font-medium text-neutral-800 dark:text-neutral-200"
            >
              <span class="flex items-center gap-2.5">
                <span class="font-mono text-neutral-500 dark:text-neutral-400">GitHub</span>
              </span>
              <span class="text-neutral-900 dark:text-white font-mono text-[11px] font-bold">@ErcanKurtoglu →</span>
            </a>

            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3.5 rounded-2xl border border-neutral-200 dark:border-neutral-700/60 bg-white dark:bg-[#202020] hover:border-neutral-400 dark:hover:border-neutral-500 transition-all text-xs font-medium text-neutral-800 dark:text-neutral-200"
            >
              <span class="flex items-center gap-2.5">
                <span class="font-mono text-neutral-500 dark:text-neutral-400">LinkedIn</span>
              </span>
              <span class="text-neutral-900 dark:text-white font-mono text-[11px] font-bold">Bağlantı Kur →</span>
            </a>

            <a
              href="https://x.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3.5 rounded-2xl border border-neutral-200 dark:border-neutral-700/60 bg-white dark:bg-[#202020] hover:border-neutral-400 dark:hover:border-neutral-500 transition-all text-xs font-medium text-neutral-800 dark:text-neutral-200"
            >
              <span class="flex items-center gap-2.5">
                <span class="font-mono text-neutral-500 dark:text-neutral-400">X (Twitter)</span>
              </span>
              <span class="text-neutral-900 dark:text-white font-mono text-[11px] font-bold">Takip Et →</span>
            </a>
          </div>
        </div>

        <div class="p-6 rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#181818] space-y-2 transition-colors">
          <h4 class="text-xs font-bold text-neutral-900 dark:text-white font-mono">Gizlilik & Güvenlik</h4>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Paylaştığınız şirket süreçleri, veritabanı şemaları ve iş modeli detayları kesin gizlilik prensibiyle korunur.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Copy email logic
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-address')?.textContent?.trim() || '';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailText);
      const originalText = copyBtn.textContent;
      copyBtn.textContent = 'Kopyalandı! ✓';
      copyBtn.classList.add('text-emerald-600', 'dark:text-emerald-400');
      setTimeout(() => {
        copyBtn.textContent = originalText;
        copyBtn.classList.remove('text-emerald-600', 'dark:text-emerald-400');
      }, 2000);
    } catch (err) {
      console.error('Kopyalama hatası:', err);
    }
  });

  // URL query parameter check for auto-filling subject
  const urlParams = new URLSearchParams(window.location.search);
  const plan = urlParams.get('plan');
  if (plan) {
    const mailto = document.getElementById('mailto-link') as HTMLAnchorElement;
    if (mailto) {
      mailto.href = `mailto:iletisim@ercankurtoglu.site?subject=${encodeURIComponent(`GHL Proje Talebi: ${plan.toUpperCase()}`)}`;
    }
  }
</script>

