---
import Layout from '../layouts/Layout.astro';

// Cal.com settings
const CAL_USER = 'ercan-kurtoglu-qztefd';
const CAL_EVENT = '15min';
const CAL_LINK = `${CAL_USER}/${CAL_EVENT}`;
---

<Layout
  title="Görüşme Planla & İletişim | Ercan Kurtoğlu"
  description="GoHighLevel iş kurulumları, yapay zekâ danışmanlığı veya teknik iş birlikleri için doğrudan takvimden görüşme planlayın."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-8 lg:px-12 py-12 sm:py-20 lg:py-24">
    <!-- Header -->
    <header class="border-b border-neutral-200 dark:border-neutral-800 pb-8 sm:pb-12 mb-10 sm:mb-14 transition-colors">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 text-xs font-mono font-medium mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        // RANDEVU & GÖRÜŞME
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-white font-sans">
        Görüşme <span class="text-dj-italics text-neutral-700 dark:text-neutral-300">Planlayın</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
        15 dakikalık tanışma seansı ile GoHighLevel iş kurulumunuzu, satış hunilerinizi veya yapay zekâ otomasyon ihtiyaçlarınızı doğrudan değerlendirelim.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left Column: Interactive Cal.com Embed (Span 7 or 8) -->
      <div class="lg:col-span-8 space-y-6">
        <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#fbfbfb] dark:bg-[#151515] p-4 sm:p-6 lg:p-8 transition-colors shadow-xs">
          <!-- Calendar Card Header -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-neutral-200 dark:border-neutral-800">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-black dark:bg-white text-white dark:text-black flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                🗓️
              </div>
              <div>
                <h2 class="text-base sm:text-lg font-extrabold text-neutral-900 dark:text-white">
                  15 Dk Keşif & Sistem Görüşmesi
                </h2>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 font-mono">
                  Google Meet / Zoom · Ücretsiz Seans
                </p>
              </div>
            </div>

            <a
              id="cal-direct-link"
              href={`https://cal.com/${CAL_LINK}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-xs font-bold text-neutral-800 dark:text-neutral-200 hover:border-black dark:hover:border-white transition-all shadow-2xs"
            >
              <span>Yeni Sekmede Aç</span>
              <span class="text-neutral-400">↗</span>
            </a>
          </div>

          <!-- Cal.com Embedded Widget Container -->
          <div class="w-full rounded-2xl overflow-hidden bg-white dark:bg-[#121212] border border-neutral-200/80 dark:border-neutral-800 min-h-[580px] sm:min-h-[640px] flex items-center justify-center relative">
            <div
              id="my-cal-inline"
              class="w-full h-full min-h-[580px] sm:min-h-[640px]"
              data-cal-link={CAL_LINK}
            ></div>
          </div>
          
          <div class="mt-4 flex items-center justify-between text-[11px] text-neutral-500 dark:text-neutral-400 font-mono">
            <span>⚡ Otomatik saat dilimi tespiti</span>
            <span>🔒 Uçtan uca şifreli takvim</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Direct Channels, Checklist & Info (Span 4) -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Direct Email Fallback Card -->
        <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#f9fafb] dark:bg-[#181818] p-6 space-y-4 transition-colors">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-neutral-200 dark:bg-neutral-800 text-neutral-900 dark:text-white flex items-center justify-center font-bold text-sm shrink-0">
              ✉️
            </div>
            <div>
              <h3 class="text-sm font-extrabold text-neutral-900 dark:text-white">
                Doğrudan Yazılı İletişim
              </h3>
              <p class="text-[11px] text-neutral-500 dark:text-neutral-400">
                Görüşme öncesi proje detayı iletmek isterseniz
              </p>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-white dark:bg-[#202020] border border-neutral-200 dark:border-neutral-700/60 flex flex-col gap-2.5">
            <div
              id="email-address"
              class="font-mono text-xs font-bold text-neutral-900 dark:text-white select-all break-all"
            >
              iletisim@ercankurtoglu.site
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="copy-email-btn"
                class="flex-1 px-3 py-1.5 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-[11px] font-bold text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors cursor-pointer text-center"
              >
                Kopyala
              </button>
              <a
                id="mailto-link"
                href="mailto:iletisim@ercankurtoglu.site?subject=GHL%20ve%20AI%20Sistem%20G%C3%B6r%C3%BC%C5%9Fmesi"
                class="flex-1 px-3 py-1.5 rounded-full bg-black dark:bg-white text-white dark:text-black text-[11px] font-bold hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors text-center shadow-xs whitespace-nowrap"
              >
                E-posta →
              </a>
            </div>
          </div>
        </div>

        <!-- Scope Checklist Card -->
        <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#181818] p-6 space-y-3.5 transition-colors">
          <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white font-mono">
            Görüşmede Neleri Ele Alabiliriz?
          </h3>
          <ul class="space-y-2.5 text-xs text-neutral-600 dark:text-neutral-400">
            <li class="flex items-start gap-2">
              <span class="text-black dark:text-white font-bold shrink-0">✓</span>
              <span>GoHighLevel sub-account, pipeline ve satış hunisi kurguları</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-black dark:text-white font-bold shrink-0">✓</span>
              <span>Şirket verilerinizle 7/24 çalışan AI randevu ve satış ajanları</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-black dark:text-white font-bold shrink-0">✓</span>
              <span>Mevcut otomasyon kaçaklarının analizi ve denetimi (Audit)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-black dark:text-white font-bold shrink-0">✓</span>
              <span>Özel API, Webhook ve Zapier/Make altyapı entegrasyonları</span>
            </li>
          </ul>
        </div>

        <!-- Social Channels -->
        <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-[#f9fafb] dark:bg-[#181818] p-6 space-y-3 transition-colors">
          <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white font-mono">
            Diğer Kanallar
          </h3>
          <div class="space-y-2">
            <a
              href="https://github.com/ErcanKurtoglu"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3 rounded-2xl border border-neutral-200 dark:border-neutral-700/60 bg-white dark:bg-[#202020] hover:border-neutral-400 dark:hover:border-neutral-500 transition-all text-xs font-medium text-neutral-800 dark:text-neutral-200"
            >
              <span class="font-mono text-neutral-500 dark:text-neutral-400">GitHub</span>
              <span class="text-neutral-900 dark:text-white font-mono text-[11px] font-bold">@ErcanKurtoglu →</span>
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3 rounded-2xl border border-neutral-200 dark:border-neutral-700/60 bg-white dark:bg-[#202020] hover:border-neutral-400 dark:hover:border-neutral-500 transition-all text-xs font-medium text-neutral-800 dark:text-neutral-200"
            >
              <span class="font-mono text-neutral-500 dark:text-neutral-400">LinkedIn</span>
              <span class="text-neutral-900 dark:text-white font-mono text-[11px] font-bold">Profil →</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- Cal.com Official Embed Script with Dynamic Theme Sync -->
<script type="text/javascript">
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  function initCalEmbed() {
    const calEl = document.getElementById("my-cal-inline");
    if (!calEl) return;

    const calLink = calEl.getAttribute("data-cal-link") || "ercan-kurtoglu-qztefd/15min";
    const isDark = document.documentElement.classList.contains("dark");

    Cal("init", { origin: "https://cal.com" });

    Cal("inline", {
      elementOrSelector: "#my-cal-inline",
      calLink: calLink,
      layout: "month_view"
    });

    Cal("ui", {
      styles: {
        branding: { brandColor: isDark ? "#ffffff" : "#000000" }
      },
      hideEventTypeDetails: false,
      layout: "month_view",
      theme: isDark ? "dark" : "light"
    });
  }

  // Run on load and on Astro page navigations
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCalEmbed);
  } else {
    initCalEmbed();
  }
  document.addEventListener("astro:page-load", initCalEmbed);

  // Copy email logic
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-address')?.textContent?.trim() || '';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailText);
      const originalText = copyBtn.textContent;
      copyBtn.textContent = 'Kopyalandı! ✓';
      copyBtn.classList.add('text-emerald-600', 'dark:text-emerald-400');
      setTimeout(() => {
        copyBtn.textContent = originalText;
        copyBtn.classList.remove('text-emerald-600', 'dark:text-emerald-400');
      }, 2000);
    } catch (err) {
      console.error('Kopyalama hatası:', err);
    }
  });

  // URL query parameter check for auto-filling subject
  const urlParams = new URLSearchParams(window.location.search);
  const plan = urlParams.get('plan');
  if (plan) {
    const mailto = document.getElementById('mailto-link');
    if (mailto) {
      mailto.href = `mailto:iletisim@ercankurtoglu.site?subject=${encodeURIComponent(`GHL Proje Talebi: ${plan.toUpperCase()}`)}`;
    }
  }
</script>
