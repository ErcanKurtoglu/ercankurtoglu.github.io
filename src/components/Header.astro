---
import Logo from './Logo.astro';
// Clean, modern header focusing on brand, controls, and high-impact actions
---

<header class="border-b border-neutral-200 dark:border-neutral-800 bg-white/95 dark:bg-[#121212]/95 backdrop-blur-md sticky top-0 z-50 transition-colors duration-200">
  <div class="px-3.5 sm:px-8 lg:px-10 h-16 sm:h-20 flex items-center justify-between gap-2 max-w-full">
    <!-- Logo (Standalone Symbol) -->
    <a href="/" class="flex items-center group shrink-0" aria-label="Ercan Kurtoğlu">
      <Logo variant="boxed" className="w-8 h-8 sm:w-9 sm:h-9" />
    </a>

    <!-- Right Controls: Language & Theme -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      
      <!-- Language Pill Switcher: TR | EN -->
      <div class="inline-flex items-center rounded-full border border-neutral-200 dark:border-neutral-800 p-0.5 bg-neutral-100 dark:bg-neutral-900 text-[10px] sm:text-[11px] font-bold transition-colors">
        <button
          type="button"
          id="lang-tr-btn"
          class="lang-btn px-2.5 py-1 rounded-full transition-all font-bold bg-white dark:bg-neutral-800 text-black dark:text-white shadow-xs cursor-pointer"
          data-lang="tr"
          aria-label="Türkçe gösterim"
        >
          TR
        </button>
        <button
          type="button"
          id="lang-en-btn"
          class="lang-btn px-2.5 py-1 rounded-full transition-all font-medium text-neutral-500 hover:text-black dark:hover:text-white cursor-pointer"
          data-lang="en"
          aria-label="English display"
        >
          EN
        </button>
      </div>

      <!-- Theme Toggle (Light / Dark) -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label="Temayı değiştir"
        class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900 flex items-center justify-center text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200/70 dark:hover:bg-neutral-800 transition-all cursor-pointer shrink-0"
        title="Işık / Karanlık Mod"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block text-neutral-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="5" stroke-width="2"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="w-4 h-4 block dark:hidden text-neutral-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

    </div>
  </div>
</header>
