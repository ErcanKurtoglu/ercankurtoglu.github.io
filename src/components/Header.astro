---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const navLinks = [
  { href: isHome ? '#how-it-works' : '/#how-it-works', label: 'Nasıl Çalışır?', key: 'nav.howItWorks' },
  { href: isHome ? '#benefits' : '/#benefits', label: 'Avantajlar', key: 'nav.benefits' },
  { href: isHome ? '#work' : '/#work', label: 'Projeler', key: 'nav.work' },
  { href: isHome ? '#about' : '/#about', label: 'Kurucu', key: 'nav.about' },
  { href: isHome ? '#pricing' : '/#pricing', label: 'Fiyatlar', key: 'nav.pricing' },
  { href: '/writing', label: 'Yazılar', key: 'nav.writing' },
  { href: isHome ? '#faq' : '/#faq', label: 'SSS', key: 'nav.faq' },
];
---

<header class="border-b border-neutral-200 dark:border-neutral-800 bg-white/95 dark:bg-[#121212]/95 backdrop-blur-md sticky top-0 z-50 transition-colors duration-200">
  <div class="px-4 sm:px-10 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-black dark:bg-white text-white dark:text-black flex items-center justify-center font-extrabold text-sm tracking-wider shadow-sm transition-colors">
        EK
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-black dark:text-white text-base sm:text-lg tracking-tight font-sans transition-colors">
          Ercan Kurtoğlu
        </span>
      </div>
    </a>

    <!-- Center Nav (Desktop) -->
    <nav class="hidden xl:flex items-center space-x-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-i18n={link.key}
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right Controls: Language, Theme & Actions -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      
      <!-- Language Pill Switcher: TR | EN -->
      <div class="inline-flex items-center rounded-full border border-neutral-200 dark:border-neutral-800 p-0.5 bg-neutral-100 dark:bg-neutral-900 text-[11px] font-bold transition-colors">
        <button
          type="button"
          id="lang-tr-btn"
          class="lang-btn px-2.5 py-1 rounded-full transition-all font-bold bg-white dark:bg-neutral-800 text-black dark:text-white shadow-xs"
          data-lang="tr"
          aria-label="Türkçe gösterim"
        >
          TR
        </button>
        <button
          type="button"
          id="lang-en-btn"
          class="lang-btn px-2.5 py-1 rounded-full transition-all font-medium text-neutral-500 hover:text-black dark:hover:text-white"
          data-lang="en"
          aria-label="English display"
        >
          EN
        </button>
      </div>

      <!-- Theme Toggle (Light / Dark) -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label="Temayı değiştir"
        class="w-8 h-8 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900 flex items-center justify-center text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200/70 dark:hover:bg-neutral-800 transition-all cursor-pointer"
        title="Işık / Karanlık Mod"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block text-neutral-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="5" stroke-width="2"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="w-4 h-4 block dark:hidden text-neutral-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- Book a Call Button -->
      <a
        href="/contact"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-neutral-300 dark:border-neutral-700 text-xs font-bold text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-neutral-500 dark:text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span data-i18n="nav.bookCall">Görüşme Planla</span>
      </a>

      <!-- See Pricing / Plans Button -->
      <a
        href="/#pricing"
        class="inline-flex items-center justify-center px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-black dark:bg-white text-white dark:text-black text-xs font-bold hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all shadow-sm"
      >
        <span data-i18n="nav.seePlans">Planları Gör</span>
      </a>

    </div>
  </div>
</header>
