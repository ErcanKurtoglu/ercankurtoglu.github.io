---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const navItems = [
  { href: isHome ? '#how-it-works' : '/#how-it-works', label: 'Nasıl Çalışır?' },
  { href: isHome ? '#benefits' : '/#benefits', label: 'Avantajlar' },
  { href: isHome ? '#work' : '/#work', label: 'Projeler' },
  { href: isHome ? '#about' : '/#about', label: 'Kurucu' },
  { href: isHome ? '#scope' : '/#scope', label: 'Kapsam' },
  { href: isHome ? '#pricing' : '/#pricing', label: 'Fiyatlar' },
  { href: '/writing', label: 'Yazılar & AI' },
  { href: isHome ? '#faq' : '/#faq', label: 'SSS' },
];
---

<header class="border-b border-neutral-200/80 bg-white/95 backdrop-blur-md sticky top-0 z-50 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo / Name -->
      <a href="/" class="group flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-black text-white flex items-center justify-center font-extrabold text-sm tracking-wider group-hover:scale-105 transition-transform">
          EK
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-neutral-900 text-base tracking-tight group-hover:text-black transition-colors">
            Ercan Kurtoğlu
          </span>
          <span class="text-[11px] text-neutral-500 font-mono tracking-tight">
            GHL & AI System Architect
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center space-x-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3.5 py-2 rounded-full text-xs font-semibold text-neutral-600 hover:text-black hover:bg-neutral-100 transition-all"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/#pricing"
          class="text-xs font-bold text-neutral-700 hover:text-black px-3 py-2 transition-colors"
        >
          Planları Gör
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold text-white bg-black rounded-full hover:bg-neutral-800 transition-all shadow-sm group"
        >
          <span>Görüşme Planla</span>
          <svg class="w-3.5 h-3.5 ml-1.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex lg:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="p-2 rounded-xl text-neutral-700 hover:text-black hover:bg-neutral-100 border border-neutral-200"
          aria-label="Menüyü aç"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-200 bg-white px-4 pt-3 pb-6 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2.5 rounded-xl text-sm font-semibold text-neutral-700 hover:text-black hover:bg-neutral-100"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-4 flex flex-col gap-2">
      <a
        href="/#pricing"
        class="w-full text-center py-2.5 rounded-full border border-neutral-200 text-neutral-900 text-xs font-bold"
      >
        Planları Gör
      </a>
      <a
        href="/contact"
        class="w-full text-center py-2.5 rounded-full bg-black text-white text-xs font-bold"
      >
        Görüşme Planla →
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
    });
  });
</script>
