---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const navLinks = [
  { href: isHome ? '#how-it-works' : '/#how-it-works', label: 'Nasıl Çalışır?' },
  { href: isHome ? '#benefits' : '/#benefits', label: 'Avantajlar' },
  { href: isHome ? '#work' : '/#work', label: 'Projeler' },
  { href: isHome ? '#about' : '/#about', label: 'Kurucu' },
  { href: isHome ? '#pricing' : '/#pricing', label: 'Fiyatlar' },
  { href: '/writing', label: 'Yazılar' },
  { href: isHome ? '#faq' : '/#faq', label: 'SSS' },
];
---

<header class="border-b border-neutral-200 bg-white sticky top-0 z-50">
  <div class="px-6 sm:px-10 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-black text-white flex items-center justify-center font-extrabold text-sm tracking-wider">
        EK
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-black text-lg tracking-tight font-sans">
          Ercan Kurtoğlu
        </span>
      </div>
    </a>

    <!-- Center Nav -->
    <nav class="hidden xl:flex items-center space-x-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-neutral-600 hover:text-black hover:bg-neutral-100 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right Designjoy Buttons -->
    <div class="flex items-center gap-2.5">
      <a
        href="/contact"
        class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-neutral-300 text-xs font-bold text-neutral-800 hover:bg-neutral-50 transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>Görüşme Planla</span>
      </a>
      <a
        href="/#pricing"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-black text-white text-xs font-bold hover:bg-neutral-800 transition-all shadow-sm"
      >
        Planları Gör
      </a>
    </div>
  </div>
</header>
