---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const navItems = [
  { href: isHome ? '#how-it-works' : '/#how-it-works', label: 'Nasıl Çalışır?' },
  { href: isHome ? '#scope' : '/#scope', label: 'Çözümler' },
  { href: isHome ? '#work' : '/#work', label: 'Projeler' },
  { href: isHome ? '#about' : '/#about', label: 'Kurucu / Bio' },
  { href: isHome ? '#pricing' : '/#pricing', label: 'Paketler' },
  { href: '/writing', label: 'Yazılar & AI' },
  { href: isHome ? '#faq' : '/#faq', label: 'SSS' },
];
---

<header class="border-b border-white/10 bg-[#070708]/85 backdrop-blur-xl sticky top-0 z-50 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo / Name -->
      <a href="/" class="group flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 text-black flex items-center justify-center font-bold text-base tracking-wider shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
          EK
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-white text-sm tracking-tight font-heading group-hover:text-amber-400 transition-colors">
            Ercan Kurtoğlu
          </span>
          <span class="text-[11px] text-zinc-400 font-mono tracking-wider">
            GHL & AI System Architect
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center space-x-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-zinc-300 hover:text-white hover:bg-white/5 transition-all"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/#pricing"
          class="text-xs font-semibold text-zinc-300 hover:text-white px-3 py-2 transition-colors"
        >
          Planları Gör
        </a>
        <a
          href="/contact"
          class="relative inline-flex items-center justify-center px-4 py-2 text-xs font-semibold text-black bg-white rounded-lg overflow-hidden group hover:bg-zinc-200 transition-all shadow-md shadow-white/10"
        >
          <span>Görüşme Başlat</span>
          <svg class="w-3.5 h-3.5 ml-1.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex lg:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-white/5 border border-white/10"
          aria-label="Menüyü aç"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-[#070708] px-4 pt-3 pb-6 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2.5 rounded-lg text-sm font-medium text-zinc-300 hover:text-white hover:bg-white/5"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-4 flex flex-col gap-2">
      <a
        href="/#pricing"
        class="w-full text-center py-2.5 rounded-lg border border-white/10 text-white text-xs font-medium"
      >
        Planları Gör
      </a>
      <a
        href="/contact"
        class="w-full text-center py-2.5 rounded-lg bg-white text-black text-xs font-semibold"
      >
        Görüşme Başlat →
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Close menu when clicking an anchor link
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
    });
  });
</script>
