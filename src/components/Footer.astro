---
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 bg-[#fafafa]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-16 border-b border-neutral-200">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-black text-white flex items-center justify-center font-extrabold text-sm">
            EK
          </div>
          <span class="font-extrabold text-neutral-900 text-base tracking-tight">Ercan Kurtoğlu</span>
        </div>
        <p class="text-sm text-neutral-600 max-w-sm leading-relaxed">
          Geleneksel hantal ajans süreçlerini ortadan kaldıran, sabit paketlerle işletmenize anahtar teslim GoHighLevel ve yapay zekâ sistemleri kuran bağımsız sistem mimarı.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-mono font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Kasım Ayı İçin Yeni Kurulumlara Açık</span>
        </div>
      </div>

      <!-- Quick Nav -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 font-mono">Hızlı Bağlantılar</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/#how-it-works" class="text-neutral-600 hover:text-black transition-colors">Nasıl Çalışır?</a></li>
          <li><a href="/#benefits" class="text-neutral-600 hover:text-black transition-colors">Avantajlar</a></li>
          <li><a href="/#work" class="text-neutral-600 hover:text-black transition-colors">Örnek Projeler</a></li>
          <li><a href="/#about" class="text-neutral-600 hover:text-black transition-colors">Kurucu / Bio</a></li>
          <li><a href="/#pricing" class="text-neutral-600 hover:text-black transition-colors">Paketler & Fiyatlar</a></li>
          <li><a href="/writing" class="text-neutral-600 hover:text-black transition-colors">Teknik Yazılar & AI</a></li>
          <li><a href="/research" class="text-neutral-600 hover:text-black transition-colors">Akademik Araştırmalar</a></li>
        </ul>
      </div>

      <!-- Contact & Channels -->
      <div class="md:col-span-4 space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 font-mono">Doğrudan İletişim</h4>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Projeniz hakkında 1-on-1 konuşmak veya aklınıza takılanları sormak için doğrudan yazabilirsiniz.
        </p>
        <a
          href="mailto:iletisim@ercankurtoglu.site"
          class="inline-block font-mono text-sm font-bold text-neutral-900 hover:text-black underline underline-offset-4 transition-colors"
        >
          iletisim@ercankurtoglu.site →
        </a>

        <div class="pt-2 flex items-center gap-3">
          <a
            href="https://github.com/ErcanKurtoglu"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-neutral-700 hover:text-black hover:border-neutral-400 transition-colors shadow-sm"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-neutral-700 hover:text-black hover:border-neutral-400 transition-colors shadow-sm"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          </a>
          <a
            href="https://x.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-neutral-700 hover:text-black hover:border-neutral-400 transition-colors shadow-sm"
            aria-label="X"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4">
      <p>© {year} Ercan Kurtoğlu. Tüm hakları saklıdır.</p>
      <div class="flex items-center gap-6 font-mono text-[11px] text-neutral-500">
        <span>Astro v7 • Designjoy Light Architecture</span>
        <span class="inline-flex items-center gap-1.5 text-neutral-700">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Tüm Sistemler Çalışıyor
        </span>
      </div>
    </div>
  </div>
</footer>
