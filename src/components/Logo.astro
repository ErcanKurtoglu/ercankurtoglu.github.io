---
interface Props {
  className?: string;
  variant?: 'boxed' | 'pure';
  size?: number;
  id?: string;
}

const {
  className = 'w-8 h-8',
  variant = 'boxed',
  size = 32,
  id = '',
} = Astro.props;
---

{variant === 'boxed' && (
  <div
    id={id}
    class={`logo-container relative flex items-center justify-center rounded-xl bg-white dark:bg-[#181818] border border-neutral-200 dark:border-neutral-800 shadow-xs transition-all duration-200 overflow-hidden shrink-0 p-1.5 ${className}`}
  >
    <img
      src="/images/logo/slide2-transparent-black.png"
      alt="Ercan Kurtoğlu Logo"
      class="w-full h-full object-contain block dark:hidden transition-transform duration-200 group-hover:scale-105"
      width={size}
      height={size}
      loading="eager"
    />
    <img
      src="/images/logo/slide2-transparent-white.png"
      alt="Ercan Kurtoğlu Logo"
      class="w-full h-full object-contain hidden dark:block transition-transform duration-200 group-hover:scale-105"
      width={size}
      height={size}
      loading="eager"
    />
  </div>
)}

{variant === 'pure' && (
  <div
    id={id}
    class={`logo-container relative flex items-center justify-center shrink-0 p-0.5 ${className}`}
  >
    <img
      src="/images/logo/slide2-transparent-black.png"
      alt="Ercan Kurtoğlu Logo"
      class="w-full h-full object-contain block dark:hidden transition-transform duration-200 group-hover:scale-105"
      width={size}
      height={size}
      loading="eager"
    />
    <img
      src="/images/logo/slide2-transparent-white.png"
      alt="Ercan Kurtoğlu Logo"
      class="w-full h-full object-contain hidden dark:block transition-transform duration-200 group-hover:scale-105"
      width={size}
      height={size}
      loading="eager"
    />
  </div>
)}
