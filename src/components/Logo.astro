---
interface Props {
  className?: string;
  variant?: 'monogram' | 'geometric' | 'badge';
  size?: number;
}

const {
  className = 'w-8 h-8',
  variant = 'badge',
  size = 32,
} = Astro.props;
---

{variant === 'badge' && (
  <div class={`relative flex items-center justify-center rounded-xl bg-black dark:bg-white text-white dark:text-black shadow-sm transition-all duration-200 overflow-hidden shrink-0 ${className}`}>
    <svg
      width={size * 0.65}
      height={size * 0.65}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="transition-colors"
    >
      <path d="M4 4v16" />
      <path d="M4 4h9" />
      <path d="M4 12h7" />
      <path d="M4 20h9" />
      <path d="M12 12l8-8" />
      <path d="M12 12l8 8" />
    </svg>
  </div>
)}

{variant === 'monogram' && (
  <svg
    class={`text-black dark:text-white transition-colors shrink-0 ${className}`}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M4 4v16" />
    <path d="M4 4h9" />
    <path d="M4 12h7" />
    <path d="M4 20h9" />
    <path d="M12 12l8-8" />
    <path d="M12 12l8 8" />
  </svg>
)}

{variant === 'geometric' && (
  <div class={`relative flex items-center justify-center rounded-xl bg-neutral-900 dark:bg-neutral-100 text-white dark:text-black shadow-sm transition-all shrink-0 ${className}`}>
    <svg
      width={size * 0.7}
      height={size * 0.7}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polygon points="12 2 21 7 21 17 12 22 3 17 3 7" stroke-width="2" />
      <line x1="12" y1="12" x2="12" y2="22" />
      <line x1="12" y1="12" x2="21" y2="7" />
      <line x1="12" y1="12" x2="3" y2="7" />
      <circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none" />
    </svg>
  </div>
)}
